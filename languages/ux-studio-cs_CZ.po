msgstr "Zapínat a vypínat moduly, měnit nastavení modulů, spravovat přesměrování. Zahrnuje Čtení."

#: build/index.63be5d1ed7f340a7e6d4.js:12
msgid "Migration access"
msgstr "Migrace"

#: build/index.63be5d1ed7f340a7e6d4.js:12
