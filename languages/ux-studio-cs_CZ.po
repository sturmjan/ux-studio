#: includes/Modules/SecurityOptimization/Module.php:625
#: includes/Modules/SecurityOptimization/Module.php:1998
msgid "This has been disabled."
msgstr "Toto bylo zakázáno."

#: includes/Modules/SecurityOptimization/Module.php:739
msgid "Lock out IPs that try a blocked username"
msgstr "Zablokovat IP, které zkusí zakázané uživatelské jméno"

#: includes/Modules/SecurityOptimization/Module.php:740
msgid "A failed login with a reserved username locks the IP out immediately (for the lockout time above) instead of after the maximum number of attempts. Requires \"Limit login attempts\" and \"Block reserved usernames\"."
msgstr "Neúspěšné přihlášení se zakázaným jménem zablokuje IP okamžitě (na dobu blokace výše), ne až po maximálním počtu pokusů. Vyžaduje „Omezit pokusy o přihlášení“ a „Blokovat vyhrazená uživatelská jména“."

#: includes/Modules/SecurityOptimization/Module.php:769
msgid "reCAPTCHA v3 minimum score"
msgstr "Minimální skóre reCAPTCHA v3"

#: includes/Modules/SecurityOptimization/Module.php:770
msgid "Only for Google reCAPTCHA v3. Score from 0.0 (bot) to 1.0 (human); requests below it are rejected. Recommended 0.5."
msgstr "Jen pro Google reCAPTCHA v3. Skóre od 0.0 (bot) do 1.0 (člověk), požadavky pod ním se odmítnou. Doporučeno 0.5."

#: includes/Modules/SecurityOptimization/Module.php:800
msgid "Adaptive mode threshold"
msgstr "Práh adaptivního režimu"

#: includes/Modules/SecurityOptimization/Module.php:801
msgid "Only for adaptive mode: after how many failed attempts from one IP the CAPTCHA starts being required (1-20)."
msgstr "Jen pro adaptivní režim: po kolika neúspěšných pokusech z jedné IP se začne vyžadovat CAPTCHA (1-20)."

#: includes/Modules/SecurityOptimization/Module.php:1114
msgid "Custom patterns (advanced)"
msgstr "Vlastní vzory (pokročilé)"

#: includes/Modules/SecurityOptimization/Module.php:1115
msgid "Your own regular expressions for suspicious code, one per line, e.g. /malicious_function\\s*\\(/i. Lines starting with # are comments. Each matching pattern adds 25 points to the file score. Invalid expressions are commented out on save and never used."
msgstr "Vlastní regulární výrazy pro podezřelý kód, jeden na řádek, např. /malicious_function\\s*\\(/i. Řádky začínající # jsou komentáře. Každý shodný vzor přidá souboru 25 bodů. Neplatné výrazy se při uložení zakomentují a nikdy se nepoužijí."

#: includes/Modules/SecurityOptimization/Module.php:1122
msgid "Skipped paths"
msgstr "Vynechané cesty"

#: includes/Modules/SecurityOptimization/Module.php:1123
msgid "Files under these paths are never scanned, one per line. Either an absolute path or a path relative to the site, e.g. wp-content/plugins/cache-plugin/. Useful for a trusted plugin that legitimately uses eval() or base64_decode()."
msgstr "Soubory pod těmito cestami se nikdy neskenují, jedna na řádek. Absolutní cesta nebo cesta relativní k webu, např. wp-content/plugins/cache-plugin/. Hodí se pro důvěryhodný plugin, který oprávněně používá eval() nebo base64_decode()."

