msgstr "Spouštět, ověřovat, zkoušet a přepínat migrace z jiných pluginů a vracet je zpět. Zahrnuje Čtení."

#: build/index.63be5d1ed7f340a7e6d4.js:12
msgid "Admin access"
msgstr "Správa"

#: build/index.63be5d1ed7f340a7e6d4.js:12
