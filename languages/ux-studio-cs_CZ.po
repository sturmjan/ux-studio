msgstr "CSS třída pro vložené SVG"

#: includes/Core/Migration/Sources/SvgSource.php:82
msgid "inline rendering"
msgstr "vkládání SVG přímo do stránky"

#: includes/Core/Migration/Sources/SvgSource.php:83
msgid "minification"
msgstr "minifikace"

#: includes/Core/Migration/Sources/SvgSource.php:84
