#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:152
msgid "[%s] The login address of your site has changed"
msgstr "[%s] Přihlašovací adresa vašeho webu se změnila"

#. translators: 1: new login address, 2: link to the setting.
#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:157
msgid "UX Studio has been updated and the custom login address you set up earlier is now really in force.\n\nLog in here from now on:\n%1$s\n\nThe usual address (wp-login.php) no longer shows the login form. Save the new address in your password manager.\n\nIf you do not want this, switch it off in UX Studio > Security > Login:\n%2$s\n\nIf you cannot log in at all, add this line to wp-config.php and the old address works again:\ndefine( 'UXSTUDIO_DISABLE_LOGIN_LOCK', true );"
msgstr "UX Studio bylo aktualizováno a vlastní přihlašovací adresa, kterou jste dříve nastavili, nyní skutečně platí.\n\nOdteď se přihlašujte tady:\n%1$s\n\nObvyklá adresa (wp-login.php) už přihlašovací formulář neukazuje. Novou adresu si uložte do správce hesel.\n\nPokud to nechcete, vypněte to v UX Studio > Zabezpečení > Přihlášení:\n%2$s\n\nPokud se nemůžete přihlásit vůbec, přidejte do wp-config.php tento řádek a stará adresa bude zase fungovat:\ndefine( 'UXSTUDIO_DISABLE_LOGIN_LOCK', true );"

#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:183
msgid "The login address of this site has changed."
msgstr "Přihlašovací adresa tohoto webu se změnila."

#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:184
msgid "The custom login address set in UX Studio is now really in force. The usual wp-login.php no longer shows the login form. Log in here from now on and save the address:"
msgstr "Vlastní přihlašovací adresa nastavená v UX Studiu nyní skutečně platí. Obvyklá adresa wp-login.php už přihlašovací formulář neukazuje. Odteď se přihlašujte tady a adresu si uložte:"

#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:235
msgid "You did not want this? Switch it off in the settings. Nothing was changed automatically."
msgstr "Nechtěli jste to? Vypněte to v nastavení. Nic se automaticky nezměnilo."

#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:236
#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:253
msgid "Open Security > Login"
msgstr "Otevřít Zabezpečení > Přihlášení"

#: includes/Modules/SecurityOptimization/LoginUrlNotice.php:237
msgid "I have saved it, hide this notice"
msgstr "Uložil(a) jsem si ji, skrýt toto upozornění"

