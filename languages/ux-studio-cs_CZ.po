msgid "Present (from %s)."
msgstr "Nalezeno (z %s)."

#: includes/Core/Migration/Sources/WpExtendedSource.php:183
msgid "Missing in UX Studio."
msgstr "V UX Studiu chybí."

#: includes/Core/Migration/Sources/XmlRpcSource.php:36
msgid "The plugin is not active, so XML-RPC is not blocked by it right now and the module setting is left as it is."
msgstr "Plugin není aktivní, takže XML-RPC teď neblokuje a nastavení modulu zůstává beze změny."

#: includes/Core/Migration/Sources/XmlRpcSource.php:39
msgid "Disable emojis"
msgstr "Vypnout emoji"

#: includes/Core/Migration/Sources/XmlRpcSource.php:45
msgid "The plugin leaves XML-RPC open for a renamed address or an allow list. The module only switches XML-RPC off completely."
msgstr "Plugin nechává XML-RPC otevřené pro přejmenovanou adresu nebo seznam povolených. Modul XML-RPC vypíná jen úplně."

#: includes/Core/Migration/Sources/XmlRpcSource.php:48
msgid "Disabling single XML-RPC methods is not available, the module switches off XML-RPC as a whole."
msgstr "Vypínání jednotlivých metod XML-RPC modul nenabízí, vypíná XML-RPC jako celek."

#: includes/Core/Migration/Sources/XmlRpcSource.php:51
msgid "The .htaccess protection and the IP lists of the plugin are not transferred."
msgstr "Ochrana přes .htaccess a seznamy IP adres z pluginu se nepřenášejí."

