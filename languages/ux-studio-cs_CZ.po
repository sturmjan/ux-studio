#: includes/Modules/SecurityOptimization/Module.php:328
msgid "Enable IP firewall"
msgstr "Zapnout IP firewall"

#: includes/Modules/SecurityOptimization/Module.php:329
msgid "Blocks every request (frontend, login, admin, REST) from banned IPs/ranges/countries. Logged-in administrators and allowlisted IPs are never blocked."
msgstr "Blokuje každý požadavek (frontend, přihlášení, administrace, REST) z blokovaných IP/rozsahů/zemí. Přihlášení administrátoři a IP na seznamu povolených nejsou nikdy blokováni."

#: includes/Modules/SecurityOptimization/Module.php:335
msgid "Client IP source"
msgstr "Zdroj IP klienta"

#: includes/Modules/SecurityOptimization/Module.php:336
msgid "Forwarded headers are only trusted in the selected mode (otherwise spoofable). Choose Cloudflare if the site is behind Cloudflare."
msgstr "Přeposílaným hlavičkám se důvěřuje pouze ve vybraném režimu (jinak je lze podvrhnout). Pokud je web za Cloudflare, zvolte Cloudflare."

#: includes/Modules/SecurityOptimization/Module.php:338
msgid "Direct connection (REMOTE_ADDR) - safe default"
msgstr "Přímé připojení (REMOTE_ADDR) – bezpečné výchozí nastavení"

#: includes/Modules/SecurityOptimization/Module.php:339
msgid "Behind Cloudflare (CF-Connecting-IP)"
msgstr "Za Cloudflare (CF-Connecting-IP)"

#: includes/Modules/SecurityOptimization/Module.php:340
msgid "Behind a reverse proxy (X-Forwarded-For)"
msgstr "Za reverzní proxy (X-Forwarded-For)"

#: includes/Modules/SecurityOptimization/Module.php:347
msgid "Allowlist (never block)"
msgstr "Seznam povolených (nikdy neblokovat)"

#: includes/Modules/SecurityOptimization/Module.php:348
msgid "IP addresses or CIDR ranges that are never blocked, one per line. Loopback is always allowed."
msgstr "IP adresy nebo CIDR rozsahy, které nejsou nikdy blokovány, jedna na řádek. Loopback je vždy povolen."

#: includes/Modules/SecurityOptimization/Module.php:354
msgid "Block page message"
msgstr "Zpráva stránky s blokováním"

#: includes/Modules/SecurityOptimization/Module.php:355
msgid "Optional message shown to a blocked visitor (403)."
msgstr "Volitelná zpráva zobrazená zablokovanému návštěvníkovi (403)."

#: includes/Modules/SecurityOptimization/Module.php:363
msgid "Enable country blocklist"
msgstr "Zapnout seznam blokovaných zemí"

#: includes/Modules/SecurityOptimization/Module.php:364
msgid "Blocks visitors from the selected countries via the IP firewall (downloads aggregated IP ranges per country)."
msgstr "Blokuje návštěvníky z vybraných zemí prostřednictvím IP firewallu (stahuje agregované rozsahy IP adres podle zemí)."

#: includes/Modules/SecurityOptimization/Module.php:370
msgid "Blocked countries"
msgstr "Blokované země"

#: includes/Modules/SecurityOptimization/Module.php:371
msgid "Selecting a country here creates/refreshes a country-type IP ban the next time settings are saved."
msgstr "Výběr země zde vytvoří/obnoví IP blokaci typu země při příštím uložení nastavení."

#: includes/Modules/SecurityOptimization/Module.php:380
msgid "Force canonical URL redirect"
msgstr "Vynutit přesměrování na kanonickou URL"

#: includes/Modules/SecurityOptimization/Module.php:381
msgid "Writes .htaccess rules that redirect every request to a single canonical version of the site, based on Settings -> General -> Site Address."
msgstr "Zapisuje pravidla do .htaccess, která přesměrují každý požadavek na jedinou kanonickou verzi webu, podle Nastavení -> Obecné -> Adresa webu."

#: includes/Modules/SecurityOptimization/Module.php:387
msgid "Force HTTPS"
msgstr "Vynutit HTTPS"

#: includes/Modules/SecurityOptimization/Module.php:388
msgid "Redirects all HTTP requests to HTTPS. Only enable with a working SSL certificate on the whole site. Ignored when canonical URL redirect is on (it already covers this)."
msgstr "Přesměruje všechny HTTP požadavky na HTTPS. Zapínejte pouze s funkčním SSL certifikátem na celém webu. Ignorováno, když je zapnuté přesměrování na kanonickou URL (to už toto pokrývá)."

#: includes/Modules/SecurityOptimization/Module.php:396
msgid "Security headers"
msgstr "Bezpečnostní hlavičky"

#: includes/Modules/SecurityOptimization/Module.php:397
msgid "Sends X-Frame-Options, X-Content-Type-Options and Referrer-Policy, both via .htaccess and as a PHP fallback."
msgstr "Odesílá X-Frame-Options, X-Content-Type-Options a Referrer-Policy, a to jak přes .htaccess, tak jako záložní řešení v PHP."

#: includes/Modules/SecurityOptimization/Module.php:403
msgid "HSTS (Strict-Transport-Security)"
msgstr "HSTS (Strict-Transport-Security)"

#: includes/Modules/SecurityOptimization/Module.php:404
msgid "Tells browsers to only ever connect over HTTPS for a year. Only enable with a valid SSL certificate everywhere on the site."
msgstr "Řekne prohlížečům, aby se po dobu jednoho roku připojovaly výhradně přes HTTPS. Zapínejte pouze s platným SSL certifikátem všude na webu."

#: includes/Modules/SecurityOptimization/Module.php:410
msgid "Permissions-Policy"
msgstr "Permissions-Policy"

#: includes/Modules/SecurityOptimization/Module.php:411
msgid "Disables browser access to camera, microphone, geolocation, payment and USB APIs by default."
msgstr "Ve výchozím nastavení zakáže prohlížeči přístup k API kamery, mikrofonu, geolokace, plateb a USB."

#: includes/Modules/SecurityOptimization/Module.php:459
msgid "Protect wp-config.php"
msgstr "Chránit wp-config.php"

#: includes/Modules/SecurityOptimization/Module.php:465
msgid "Disable directory listing"
msgstr "Zakázat výpis obsahu adresářů"

#: includes/Modules/SecurityOptimization/Module.php:471
msgid "Block readme.html / license.txt"
msgstr "Blokovat readme.html / license.txt"

#: includes/Modules/SecurityOptimization/Module.php:479
msgid "Enable custom login URL"
msgstr "Zapnout vlastní URL přihlášení"

#: includes/Modules/SecurityOptimization/Module.php:480
msgid "Rescue switch: define UXSTUDIO_DISABLE_LOGIN_LOCK in wp-config.php to bypass this feature entirely if you get locked out."
msgstr "Záchranný přepínač: definujte UXSTUDIO_DISABLE_LOGIN_LOCK ve wp-config.php, abyste tuto funkci zcela obešli v případě, že se sami zamknete."

#: includes/Modules/SecurityOptimization/Module.php:486
msgid "Custom login slug"
msgstr "Vlastní slug přihlášení"

#: includes/Modules/SecurityOptimization/Module.php:487
msgid "New slug for the login page. wp-login.php will 404 for direct visitors. If the slug collides with an existing page/rewrite rule, the redirect is automatically NOT activated (fail-open) and a warning is logged."
msgstr "Nový slug pro přihlašovací stránku. wp-login.php vrátí přímým návštěvníkům 404. Pokud slug koliduje s existující stránkou/pravidlem přepisu, přesměrování se automaticky NEaktivuje (fail-open) a zaznamená se varování."

#: includes/Modules/SecurityOptimization/Module.php:493
msgid "Direct wp-login.php behavior"
msgstr "Chování přímého přístupu na wp-login.php"

#: includes/Modules/SecurityOptimization/Module.php:495
