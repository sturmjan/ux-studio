#. Module description from meta.json
#: includes/Modules/ActivityLog/meta.json
msgid "Browse, filter and prune the site-wide activity/audit log."
msgstr "Procházení, filtrování a čištění logu aktivit/auditu celého webu."

#. Module description from meta.json
#: includes/Modules/AdminColumns/meta.json
msgid "Customize the columns shown in admin list tables for posts, pages, media, comments and users."
msgstr "Úprava sloupců zobrazených v tabulkách výpisů v administraci pro příspěvky, stránky, média, komentáře a uživatele."

#. Module description from meta.json
#: includes/Modules/AdminCustomiser/meta.json
msgid "Customize the WordPress admin menu, admin bar, login screen and more."
msgstr "Úprava administračního menu WordPressu, lišty administrace, přihlašovací obrazovky a dalšího."

#. Module description from meta.json
#: includes/Modules/AiAssistant/meta.json
msgid "AI chat widget with knowledge base (RAG), FAQ, human handoff, blog auto-generation and multi-provider support (Claude, OpenAI, DeepSeek)."
msgstr "AI chat widget se znalostní bází (RAG), FAQ, předáním člověku, automatickým generováním blogu a podporou více poskytovatelů (Claude, OpenAI, DeepSeek)."

#. Module description from meta.json
#: includes/Modules/AiMarkdown/meta.json
msgid "Serve a markdown version of your content for AI bots via /llms.txt and ?format=markdown, with a local (non-AI) conversion and access log."
msgstr "Poskytuje AI botům markdown verzi vašeho obsahu přes /llms.txt a ?format=markdown, s lokálním (ne-AI) převodem a logem přístupů."

#. Module description from meta.json
#: includes/Modules/AiPanel/meta.json
msgid "Temporary controlled access to files, database and shell for a remote AI agent (Claude Code, Codex, or similar). Access is granted once from the dashboard for a limited time, generates a URL + strong password, and is auto-revoked on expiry."
msgstr "Dočasný kontrolovaný přístup k souborům, databázi a shellu pro vzdáleného AI agenta (Claude Code, Codex apod.). Přístup se jednorázově udělí z nástěnky na omezenou dobu, vygeneruje URL + silné heslo a po vypršení se automaticky odebere."

#. Module description from meta.json
#: includes/Modules/Analytics/meta.json
msgid "Vlastní měření návštěvnosti bez cookies (GDPR-friendly) – zobrazení stránek, unikátní návštěvníci, nejnavštěvovanější stránky, zdroje a graf posledních dní. Data se dávkově agregují do denních souhrnů."
msgstr "Vlastní měření návštěvnosti bez cookies (GDPR-friendly) – zobrazení stránek, unikátní návštěvníci, nejnavštěvovanější stránky, zdroje a graf posledních dní. Data se dávkově agregují do denních souhrnů."

#. Module name from meta.json
#: includes/Modules/AutoImageUpload/meta.json
msgid "Auto Image Upload"
msgstr "Automatické nahrávání obrázků"

#. Module description from meta.json
#: includes/Modules/AutoImageUpload/meta.json
msgid "Automatically sideload external images pasted into the editor (from another site or data: URLs) into the media library."
msgstr "Automaticky stáhne externí obrázky vložené do editoru (z jiného webu nebo data: URL) do knihovny médií."

#. Module name from meta.json
#: includes/Modules/AutoUnpublish/meta.json
msgid "Auto Unpublish"
msgstr "Automatické zrušení publikace"

#. Module description from meta.json
#: includes/Modules/AutoUnpublish/meta.json
msgid "Schedule posts to be automatically switched back to draft at a chosen date and time."
msgstr "Naplánuje automatické vrácení příspěvků do konceptu ve zvolené datum a čas."

#. Module description from meta.json
#: includes/Modules/BotThrottle/meta.json
msgid "Detect bots by User-Agent pattern and rate-limit frontend requests."
msgstr "Rozpoznává boty podle vzoru User-Agent a omezuje frekvenci jejich požadavků na frontend."

#. Module name from meta.json
#: includes/Modules/ClassicEditor/meta.json
msgid "Classic Editor"
msgstr "Klasický editor"

#. Module description from meta.json
#: includes/Modules/ClassicEditor/meta.json
msgid "Replace the block editor with the classic editor for selected post types."
msgstr "Nahradí blokový editor klasickým editorem u vybraných typů obsahu."

#. Module name from meta.json
#: includes/Modules/ClassicWidgets/meta.json
msgid "Classic Widgets"
msgstr "Klasické widgety"

#. Module description from meta.json
#: includes/Modules/ClassicWidgets/meta.json
msgid "Restore the classic widgets screen by disabling the block-based widgets editor."
msgstr "Obnoví klasickou obrazovku widgetů vypnutím blokového editoru widgetů."

#. Module name from meta.json
#: includes/Modules/CleanProfiles/meta.json
msgid "Clean Profiles"
msgstr "Čisté profily"

#. Module description from meta.json
#: includes/Modules/CleanProfiles/meta.json
msgid "Hide selected sections and fields on the user profile screen to simplify it."
msgstr "Skryje vybrané sekce a pole na obrazovce uživatelského profilu a zjednoduší ji."

#. Module description from meta.json
#: includes/Modules/CodeSnippets/meta.json
msgid "Run PHP, HTML, CSS or JS snippets in the header or footer of your site."
msgstr "Spouští úryvky PHP, HTML, CSS nebo JS v hlavičce nebo patičce webu."

#. Module description from meta.json
#: includes/Modules/ContentSync/meta.json
msgid "Central broker connection to the central app: registered sites, SSO tokens and a synchronization log."
msgstr "Centrální propojení s centrální aplikací: registrované weby, SSO tokeny a log synchronizace."

#. Module description from meta.json
#: includes/Modules/CronControl/meta.json
msgid "Inspect and manage WP-Cron scheduled events."
msgstr "Prohlížení a správa naplánovaných událostí WP-Cron."

#. Module description from meta.json
#: includes/Modules/DashboardWidgets/meta.json
msgid "PageSpeed score, recent activity and quick tasks/notes."
msgstr "Skóre PageSpeed, nedávná aktivita a rychlé úkoly/poznámky."

#. Module name from meta.json
#: includes/Modules/DebugMode/meta.json
msgid "Debug Mode"
msgstr "Režim ladění"

#. Module description from meta.json
#: includes/Modules/DebugMode/meta.json
msgid "Inspect the status of WordPress debug constants and read the debug log."
msgstr "Zobrazení stavu ladicích konstant WordPressu a čtení debug logu."

#. Module name from meta.json
#: includes/Modules/DisableAutoUpdates/meta.json
msgid "Disable Auto Updates"
msgstr "Vypnutí automatických aktualizací"

#. Module description from meta.json
#: includes/Modules/DisableAutoUpdates/meta.json
msgid "Disable automatic updates for WordPress core, plugins, themes and translations."
msgstr "Vypne automatické aktualizace jádra WordPressu, pluginů, šablon a překladů."

#. Module name from meta.json
#: includes/Modules/DisableVideoUploads/meta.json
msgid "Disable Video Uploads"
msgstr "Zákaz nahrávání videí"

#. Module description from meta.json
#: includes/Modules/DisableVideoUploads/meta.json
msgid "Prevent video files from being uploaded to the media library."
msgstr "Zabrání nahrávání videosouborů do knihovny médií."

#. Module description from meta.json
#: includes/Modules/DownloadFiles/meta.json
msgid "Manage protected downloadable files (e.g. PDFs) served via a tokenized, download-counted link, and list them on the frontend with the [download_files] shortcode."
msgstr "Správa chráněných souborů ke stažení (např. PDF) poskytovaných přes odkaz s tokenem a počítadlem stažení a jejich výpis na frontendu shortcodem [download_files]."

#. Module name from meta.json
#: includes/Modules/DuplicateMenu/meta.json
msgid "Duplicate Menu"
msgstr "Duplikace menu"

#. Module description from meta.json
#: includes/Modules/DuplicateMenu/meta.json
msgid "Duplicate an existing navigation menu including all of its items."
msgstr "Duplikuje existující navigační menu včetně všech jeho položek."

#. Module name from meta.json
#: includes/Modules/DuplicatePost/meta.json
msgid "Duplicate Post"
msgstr "Duplikace příspěvků"

#. Module description from meta.json
#: includes/Modules/DuplicatePost/meta.json
msgid "Duplicate posts, pages and custom post types with one click from the post list."
msgstr "Duplikuje příspěvky, stránky a vlastní typy obsahu jedním kliknutím z výpisu příspěvků."

#. Module description from meta.json
#: includes/Modules/ElementorImport/meta.json
msgid "Import Elementor content from a JSON/ZIP file, pasted JSON, a URL or pasted HTML, and export existing pages back to JSON."
msgstr "Import obsahu Elementoru ze souboru JSON/ZIP, vloženého JSON, URL nebo vloženého HTML a export existujících stránek zpět do JSON."

#. Module name from meta.json
#: includes/Modules/EmailHealth/meta.json
msgid "Email Health"
msgstr "Stav e-mailu"

#. Module description from meta.json
#: includes/Modules/EmailHealth/meta.json
msgid "Send a test email to verify outgoing mail works and record the last result."
msgstr "Odešle testovací e-mail pro ověření funkčnosti odchozí pošty a zaznamená poslední výsledek."

#. Module description from meta.json
#: includes/Modules/EmailLog/meta.json
msgid "Record every outgoing wp_mail() send, successful or failed."
msgstr "Zaznamenává každé odeslání přes wp_mail(), úspěšné i neúspěšné."

#. Module description from meta.json
#: includes/Modules/ExitPopup/meta.json
msgid "Show a popup with an email capture form when a visitor is about to leave the page."
msgstr "Zobrazí vyskakovací okno s formulářem pro zachycení e-mailu, když se návštěvník chystá opustit stránku."

#. Module name from meta.json
#: includes/Modules/ExportPosts/meta.json
msgid "Export Posts"
msgstr "Export příspěvků"

#. Module description from meta.json
#: includes/Modules/ExportPosts/meta.json
msgid "Export post data to CSV, JSON or TXT from row actions and bulk actions."
msgstr "Export dat příspěvků do CSV, JSON nebo TXT z akcí řádků a hromadných akcí."

#. Module name from meta.json
#: includes/Modules/ExportUsers/meta.json
msgid "Export Users"
msgstr "Export uživatelů"

#. Module description from meta.json
#: includes/Modules/ExportUsers/meta.json
msgid "Export user data to CSV, JSON or TXT from row actions, bulk actions and profiles."
msgstr "Export dat uživatelů do CSV, JSON nebo TXT z akcí řádků, hromadných akcí a profilů."

#. Module name from meta.json
#: includes/Modules/ExternalPermalinks/meta.json
msgid "External Permalinks"
msgstr "Externí permalinky"

#. Module description from meta.json
#: includes/Modules/ExternalPermalinks/meta.json
msgid "Point posts, pages or custom post types to an external URL instead of the default permalink."
msgstr "Nasměruje příspěvky, stránky nebo vlastní typy obsahu na externí URL místo výchozího permalinku."

#. Module description from meta.json
#: includes/Modules/FileManager/meta.json
msgid "Browse and manage server files through the embedded Tiny File Manager. Access is restricted to an explicit whitelist of administrators."
msgstr "Procházení a správa souborů na serveru přes vestavěný Tiny File Manager. Přístup je omezen na výslovně povolený seznam administrátorů."

#. Module description from meta.json
#: includes/Modules/FolderManager/meta.json
msgid "Organize media library attachments into folders using a taxonomy - no filesystem changes."
msgstr "Uspořádání příloh knihovny médií do složek pomocí taxonomie - bez změn v souborovém systému."

#. Module description from meta.json
#: includes/Modules/Forms/meta.json
msgid "Build multi-step forms with conditional fields, file uploads and email notifications, and browse a searchable archive of submissions."
msgstr "Tvorba vícekrokových formulářů s podmíněnými poli, nahráváním souborů a e-mailovými oznámeními a prohledávatelný archiv odeslání."

#. Module description from meta.json
#: includes/Modules/GoogleReviewRequest/meta.json
msgid "Send Google review request emails after orders or reservations and track delivery stats."
msgstr "Odesílá po objednávkách nebo rezervacích e-maily se žádostí o Google recenzi a sleduje statistiky doručení."

#. Module name from meta.json
#: includes/Modules/Guide/meta.json
msgid "Guide"
msgstr "Průvodce"

#. Module description from meta.json
#: includes/Modules/Guide/meta.json
msgid "A getting-started checklist that tracks setup progress for the site."
msgstr "Kontrolní seznam pro začátek, který sleduje postup nastavení webu."

#. Module name from meta.json
#: includes/Modules/HideAdminBar/meta.json
msgid "Hide Admin Bar"
msgstr "Skrytí lišty administrace"

#. Module description from meta.json
#: includes/Modules/HideAdminBar/meta.json
msgid "Hide the WordPress admin bar on the frontend for selected roles."
msgstr "Skryje lištu administrace WordPressu na frontendu pro vybrané role."

#. Module description from meta.json
#: includes/Modules/ImageOptimizer/meta.json
msgid "Compress media library images, generate WebP/AVIF copies with next-gen delivery, auto-optimize uploads and find unused images. Originals always kept as backups."
msgstr "Komprese obrázků v knihovně médií, generování kopií WebP/AVIF s doručováním moderních formátů, automatická optimalizace nahrávaných souborů a vyhledání nepoužitých obrázků. Originály se vždy uchovávají jako záloha."

#. Module name from meta.json
#: includes/Modules/IndexingNotice/meta.json
msgid "Indexing Notice"
msgstr "Upozornění na indexování"

#. Module description from meta.json
#: includes/Modules/IndexingNotice/meta.json
msgid "Show an admin bar warning when search engines are discouraged from indexing the site."
msgstr "Zobrazí varování v liště administrace, když je vyhledávačům zakázáno web indexovat."

#. Module description from meta.json
#: includes/Modules/InstagramFeed/meta.json
msgid "Connect an Instagram account via OAuth and display its photos, videos and reels through the official Instagram Graph API. Media is cached to the media library, refreshed on a cron, and rendered by a themeable shortcode (grid, masonry, carousel, slider, highlight, showcase)."
msgstr "Připojí účet Instagram přes OAuth a zobrazí jeho fotky, videa a reels přes oficiální Instagram Graph API. Média se ukládají do knihovny médií, obnovují se cronem a vykreslují se upravitelným shortcodem (mřížka, zděná mřížka, karusel, slider, zvýraznění, přehlídka)."

#. Module name from meta.json
#: includes/Modules/LinkManager/meta.json
msgid "Link Manager"
msgstr "Správce odkazů"

#. Module description from meta.json
#: includes/Modules/LinkManager/meta.json
msgid "Control how external links behave: add rel attributes, open in new tab, arrow icon and speculative loading."
msgstr "Řízení chování externích odkazů: přidání atributů rel, otevírání v nové kartě, ikona šipky a spekulativní načítání."

#. Module description from meta.json
#: includes/Modules/MaintenanceMode/meta.json
msgid "Put the site into maintenance or coming soon mode with a customisable page while you work."
msgstr "Přepne web do režimu údržby nebo „již brzy“ s upravitelnou stránkou, zatímco na něm pracujete."

#. Module description from meta.json
#: includes/Modules/MediaReplace/meta.json
msgid "Replace an image or file in the media library by uploading a new one, keeping the same URL."
msgstr "Nahradí obrázek nebo soubor v knihovně médií nahráním nového se zachováním stejné URL."

#. Module name from meta.json
#: includes/Modules/MediaTrash/meta.json
msgid "Media Trash"
msgstr "Koš médií"

#. Module description from meta.json
#: includes/Modules/MediaTrash/meta.json
msgid "Send deleted media files to the trash instead of deleting them permanently."
msgstr "Smazané soubory médií přesouvá do koše místo trvalého smazání."

#. Module name from meta.json
#: includes/Modules/MenuIcons/meta.json
msgid "Menu Icons & Item Status"
msgstr "Ikony a stav položek menu"

#. Module description from meta.json
#: includes/Modules/MenuIcons/meta.json
msgid "Add an icon (SVG, Lucide, or Media Library) to navigation menu items and mark individual items as hidden or disabled."
msgstr "Přidá k položkám navigačního menu ikonu (SVG, Lucide nebo z knihovny médií) a umožní označit jednotlivé položky jako skryté nebo vypnuté."

#. Module name from meta.json
#: includes/Modules/MenuVisibility/meta.json
msgid "Menu Visibility"
msgstr "Viditelnost menu"

#. Module description from meta.json
#: includes/Modules/MenuVisibility/meta.json
msgid "Show or hide individual navigation menu items based on the visitor's login status."
msgstr "Zobrazí nebo skryje jednotlivé položky navigačního menu podle toho, zda je návštěvník přihlášen."

#. Module description from meta.json
#: includes/Modules/NoticeBoard/meta.json
msgid "Public notice board with downloadable documents, categories and email subscriptions."
msgstr "Veřejná nástěnka oznámení s dokumenty ke stažení, kategoriemi a odběrem e-mailem."

#. Module description from meta.json
#: includes/Modules/OpeningHours/meta.json
msgid "Manage branch locations, weekly opening hours and exceptions, with a live open/closed status API. (Scope note: legacy shortcodes/map widgets are intentionally not ported yet - CRUD + status API only.)"
msgstr "Správa poboček, týdenní otevírací doby a výjimek s API pro aktuální stav otevřeno/zavřeno. (Poznámka k rozsahu: starší shortcody/widgety map záměrně zatím nejsou převedeny - jen CRUD + API stavu.)"

#. Module description from meta.json
#: includes/Modules/PageLoad/meta.json
msgid "Sample and report server-side page response times."
msgstr "Vzorkování a reporting doby odezvy stránek na straně serveru."

#. Module description from meta.json
#: includes/Modules/PerformanceOptimization/meta.json
msgid "Read-only database/content health checks with a small whitelist of safe cleanup actions and score history."
msgstr "Kontroly stavu databáze/obsahu jen pro čtení s malým seznamem bezpečných úklidových akcí a historií skóre."

#. Module name from meta.json
#: includes/Modules/PixelTagManager/meta.json
msgid "Pixel & Tag Manager"
msgstr "Pixel & Tag Manager"

#. Module description from meta.json
#: includes/Modules/PixelTagManager/meta.json
msgid "Add tracking pixels and tags for Google Analytics, Facebook Pixel and Pinterest to the site head."
msgstr "Přidá do hlavičky webu měřicí pixely a tagy pro Google Analytics, Facebook Pixel a Pinterest."

#. Module description from meta.json
#: includes/Modules/PopupManager/meta.json
msgid "Create and target on-site popups with delay, scroll or page-load triggers and track impressions/clicks."
msgstr "Tvorba a cílení vyskakovacích oken na webu se spouštěním po prodlevě, posunu stránky nebo načtení a sledováním zobrazení/kliknutí."

#. Module name from meta.json
#: includes/Modules/PostGallery/meta.json
msgid "Post Gallery"
msgstr "Galerie příspěvku"

#. Module description from meta.json
#: includes/Modules/PostGallery/meta.json
msgid "Attach an image gallery to any post or page with a grid layout and lightbox."
msgstr "Připojí k libovolnému příspěvku nebo stránce galerii obrázků s mřížkou a lightboxem."

#. Module name from meta.json
#: includes/Modules/PostIdDisplay/meta.json
msgid "Post ID Display"
msgstr "Zobrazení ID příspěvku"

#. Module description from meta.json
#: includes/Modules/PostIdDisplay/meta.json
msgid "Show the post ID in the row actions of post list tables."
msgstr "Zobrazí ID příspěvku v akcích řádků ve výpisech příspěvků."

#. Module name from meta.json
#: includes/Modules/PostTypeOrder/meta.json
msgid "Post Type Order"
msgstr "Pořadí příspěvků"

#. Module description from meta.json
#: includes/Modules/PostTypeOrder/meta.json
msgid "Reorder posts, pages and custom post types with drag and drop in the admin list tables."
msgstr "Změna pořadí příspěvků, stránek a vlastních typů obsahu přetažením ve výpisech v administraci."

#. Module description from meta.json
#: includes/Modules/PostTypeSwitcher/meta.json
msgid "Switch the post type of your content to reorganise and reuse existing posts and pages."
msgstr "Změna typu obsahu u vašeho obsahu pro reorganizaci a opětovné využití existujících příspěvků a stránek."

#. Module description from meta.json
#: includes/Modules/PushNotifications/meta.json
msgid "Web push (VAPID) subscriptions and notifications, with delivery/click event tracking."
msgstr "Odběry a oznámení web push (VAPID) se sledováním doručení a kliknutí."

#. Module name from meta.json
#: includes/Modules/QuickAddPost/meta.json
msgid "Quick Add Post"
msgstr "Rychlé přidání příspěvku"

#. Module description from meta.json
#: includes/Modules/QuickAddPost/meta.json
msgid "Add a New button to the block editor toolbar for quickly creating another post."
msgstr "Přidá do panelu nástrojů blokového editoru tlačítko Nový pro rychlé vytvoření dalšího příspěvku."

#. Module name from meta.json
#: includes/Modules/QuickImage/meta.json
msgid "Quick Image"
msgstr "Rychlý obrázek"

#. Module description from meta.json
#: includes/Modules/QuickImage/meta.json
msgid "Change the featured image straight from the posts and pages list tables via a thumbnail column."
msgstr "Změna náhledového obrázku přímo ve výpisech příspěvků a stránek pomocí sloupce s náhledem."

#. Module name from meta.json
#: includes/Modules/Redirect404ToHomepage/meta.json
msgid "Redirect 404 to Homepage"
msgstr "Přesměrování 404 na úvodní stránku"

#. Module description from meta.json
#: includes/Modules/Redirect404ToHomepage/meta.json
msgid "Redirect 404 error pages to the homepage with a 301 redirect."
msgstr "Přesměruje chybové stránky 404 na úvodní stránku pomocí přesměrování 301."

#. Module description from meta.json
#: includes/Modules/ReviewAggregator/meta.json
msgid "Aggregate Google, Facebook and Mapy.cz reviews through the Content Sync broker - no local scraping or API keys on this site."
msgstr "Agregace recenzí z Google, Facebooku a Mapy.cz přes broker Synchronizace obsahu - na tomto webu žádné lokální stahování ani API klíče."

#. Module description from meta.json
#: includes/Modules/RollbackManager/meta.json
msgid "Roll back an installed plugin or theme to an older version pulled from WordPress.org."
msgstr "Vrátí nainstalovaný plugin nebo šablonu na starší verzi stažením z WordPress.org."

#. Module description from meta.json
#: includes/Modules/SecurityOptimization/meta.json
msgid "Login protection, IP bans, country blocklist, custom login URL, .htaccess hardening and security headers."
msgstr "Ochrana přihlášení, blokace IP, blokování zemí, vlastní přihlašovací URL, zabezpečení .htaccess a bezpečnostní hlavičky."

#. Module description from meta.json
#: includes/Modules/ServiceRequests/meta.json
msgid "Internal system for tracking service/change requests for the site, with media library attachments."
msgstr "Interní systém pro evidenci servisních požadavků a požadavků na změny webu s přílohami z knihovny médií."

#. Module description from meta.json
#: includes/Modules/SmtpEmail/meta.json
msgid "Route outgoing mail through SMTP or the Brevo API and keep a delivery log."
msgstr "Směruje odchozí poštu přes SMTP nebo Brevo API a vede log doručení."

#. Module description from meta.json
#: includes/Modules/StockPhotos/meta.json
msgid "Search and import images from Pexels, Pixabay, Unsplash, Flickr, Mapillary, Giphy and Openverse straight into the media library."
msgstr "Vyhledávání a import obrázků z Pexels, Pixabay, Unsplash, Flickr, Mapillary, Giphy a Openverse přímo do knihovny médií."

#. Module name from meta.json
#: includes/Modules/SvgUpload/meta.json
msgid "SVG Upload"
msgstr "Nahrávání SVG"

#. Module description from meta.json
#: includes/Modules/SvgUpload/meta.json
msgid "Allow SVG files to be uploaded to the media library, sanitized on the way in for selected roles."
msgstr "Povolí vybraným rolím nahrávat SVG soubory do knihovny médií, při nahrání se sanitizují."

#. Module description from meta.json
#: includes/Modules/ThirdPartyLogin/meta.json
msgid "Sign in via Google, Facebook, Apple or Seznam through the central app as an OAuth proxy."
msgstr "Přihlášení přes Google, Facebook, Apple nebo Seznam s centrální aplikací jako OAuth proxy."

#. Module name from meta.json
#: includes/Modules/TopBar/meta.json
msgid "Top Bar"
msgstr "Horní lišta"

#. Module description from meta.json
#: includes/Modules/TopBar/meta.json
msgid "Show a scheduled announcement bar at the top of the site with custom colours."
msgstr "Zobrazí v horní části webu naplánovanou oznamovací lištu s vlastními barvami."

#. Module name from meta.json
#: includes/Modules/UserLastLogin/meta.json
msgid "User Last Login"
msgstr "Poslední přihlášení uživatele"

#. Module description from meta.json
#: includes/Modules/UserLastLogin/meta.json
msgid "Record each user's last login time and show it as a column on the Users screen."
msgstr "Zaznamenává čas posledního přihlášení každého uživatele a zobrazuje jej jako sloupec na obrazovce Uživatelé."

#. Module description from meta.json
#: includes/Modules/UserSwitching/meta.json
msgid "Instantly switch between user accounts to test roles and troubleshoot, then switch straight back."
msgstr "Okamžité přepínání mezi uživatelskými účty pro testování rolí a řešení problémů a pak rychlý návrat zpět."

#. Module description from meta.json
#: includes/Modules/VulnerabilityScanner/meta.json
msgid "Check installed plugins, themes and WordPress core for known vulnerabilities and outdated versions using WordPress.org, plus real CVE data from WPScan when an API key is provided."
msgstr "Kontrola nainstalovaných pluginů, šablon a jádra WordPressu na známé zranitelnosti a zastaralé verze pomocí WordPress.org a navíc reálná data CVE z WPScan, pokud je zadán API klíč."

#. Module description from meta.json
#: includes/Modules/WooCommerce/meta.json
msgid "Native wp-admin dashboard widgets for recent orders and top-selling products (requires WooCommerce)."
msgstr "Nativní widgety nástěnky wp-admin pro nejnovější objednávky a nejprodávanější produkty (vyžaduje WooCommerce)."
