#. translators: %s: new URL path
#: includes/Modules/Redirects/Module.php:175
#, php-format
msgid "URL changed to %s"
msgstr "URL změněna na %s"

#: includes/Modules/Redirects/Module.php:189
msgid "Redirect automatically when a URL changes"
msgstr "Automaticky přesměrovat při změně URL"

#: includes/Modules/Redirects/Module.php:190
msgid "When a published post or page changes its slug or parent, a 301 from the old URL is created (also for child pages)."
msgstr "Když publikovaný příspěvek nebo stránka změní slug nebo nadřazenou stránku, vytvoří se 301 ze staré URL (i pro podstránky)."

#: includes/Modules/Redirects/Module.php:196
msgid "Keep the query string"
msgstr "Zachovat parametry URL"

#: includes/Modules/Redirects/Module.php:197
msgid "Carries ?utm_source, gclid and similar parameters over to the target so campaign tracking survives the redirect."
msgstr "Přenese ?utm_source, gclid a podobné parametry na cíl, aby měření kampaní přežilo přesměrování."

#: includes/Modules/Redirects/Module.php:203
msgid "Browser cache for permanent redirects (seconds)"
msgstr "Cache prohlížeče pro trvalá přesměrování (sekundy)"

#: includes/Modules/Redirects/Module.php:204
msgid "Browsers cache a 301 forever unless told otherwise. 3600 keeps mistakes fixable; 0 = no caching."
msgstr "Prohlížeče si 301 bez dalšího pokynu pamatují navždy. 3600 nechá chyby opravitelné; 0 = bez cache."

#: includes/Modules/Redirects/Module.php:210
msgid "Count hits per rule"
msgstr "Počítat návštěvy u pravidel"

#: includes/Modules/Redirects/Module.php:211
msgid "Shows which old URLs still get traffic (one small database write per redirect)."
msgstr "Ukáže, které staré URL ještě mají návštěvnost (jeden malý zápis do databáze na přesměrování)."

#: includes/Modules/Redirects/Module.php:217
msgid "Log 404 errors"
msgstr "Zaznamenávat chyby 404"

#: includes/Modules/Redirects/Module.php:218
msgid "Aggregated per URL with hit count and referrer, no IP addresses."
msgstr "Souhrnně po URL s počtem návštěv a odkazující stránkou, bez IP adres."

#: includes/Modules/Redirects/Module.php:224
msgid "Keep 404 entries for (days)"
msgstr "Uchovávat záznamy 404 (dní)"

#: includes/Modules/Redirects/Module.php:225
msgid "Entries not seen for this long are removed. 0 = keep."
msgstr "Záznamy, které se tak dlouho neobjevily, se smažou. 0 = ponechat."

#: includes/Modules/Redirects/Repository.php:494
msgid "Rule not found."
msgstr "Pravidlo nenalezeno."

#: includes/Modules/Redirects/Repository.php:520
msgid "match_type must be \"exact\" or \"regex\"."
msgstr "match_type musí být „exact\" nebo „regex\"."

#: includes/Modules/Redirects/Repository.php:523
msgid "code must be one of 301, 302, 307, 308, 410."
msgstr "code musí být jeden z kódů 301, 302, 307, 308, 410."

#: includes/Modules/Redirects/Repository.php:536
msgid "Source is required."
msgstr "Zdrojová URL je povinná."

#: includes/Core/Migration/Sources/RedirectsSource.php:610
#: includes/Modules/Redirects/Repository.php:539
msgid "Source is not a valid regular expression."
msgstr "Zdroj není platný regulární výraz."

#: includes/Modules/Redirects/Repository.php:547
msgid "Source is not a valid URL or path."
msgstr "Zdroj není platná URL ani cesta."

#: includes/Modules/Redirects/Repository.php:549
msgid "The homepage itself cannot be redirected."
msgstr "Úvodní stránku samotnou nelze přesměrovat."

#: includes/Modules/Redirects/Repository.php:551
msgid "WordPress system paths (wp-admin, wp-login.php, wp-json…) cannot be redirected."
msgstr "Systémové cesty WordPressu (wp-admin, wp-login.php, wp-json…) nelze přesměrovat."

#: includes/Modules/Redirects/Repository.php:566
msgid "target_post_id must be a published, publicly viewable post."
msgstr "target_post_id musí být publikovaný, veřejně zobrazitelný příspěvek."

#: includes/Core/Migration/Sources/RedirectsSource.php:616
#: includes/Modules/Redirects/Repository.php:571
msgid "Target (URL or target_post_id) is required unless code is 410."
msgstr "Cíl (URL nebo target_post_id) je povinný, pokud kód není 410."

#: includes/Modules/Redirects/Repository.php:573
msgid "Protocol-relative targets (//host) are not allowed, use https://."
msgstr "Cíle bez protokolu (//host) nejsou povolené, použijte https://."

#: includes/Modules/Redirects/Repository.php:577
msgid "Target must be a site path starting with \"/\" or an http(s) URL."
msgstr "Cíl musí být cesta na webu začínající „/\" nebo http(s) URL."

#: includes/Modules/Redirects/Repository.php:606
msgid "This redirect would create a loop (the target leads back to the source)."
msgstr "Toto přesměrování by vytvořilo smyčku (cíl vede zpět na zdroj)."

#: includes/Modules/Redirects/Repository.php:636
msgid "The target itself is marked 410 Gone - pick a live page or use 410 for this source too."
msgstr "Cíl je sám označený jako 410 Gone - vyberte živou stránku, nebo použijte 410 i pro tento zdroj."

