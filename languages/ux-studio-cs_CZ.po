msgstr "Návštěvník je přihlášený"

#: includes/Modules/MenuVisibility/Module.php:97
msgid "Visitor is logged out"
msgstr "Návštěvník je odhlášený"

#: includes/Modules/MenuVisibility/Module.php:98
