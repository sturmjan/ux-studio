msgstr "Verze API"

msgid "Language"
msgstr "Jazyk"

msgid "Toggle dark mode"
msgstr "Přepnout tmavý režim"

msgid "Light mode"
msgstr "Světlý režim"

msgid "Dark mode"
msgstr "Tmavý režim"

msgid "UX Studio navigation"
msgstr "Navigace UX Studio"

msgid "Select gallery images"
msgstr "Vybrat obrázky galerie"

msgid "Add to gallery"
msgstr "Přidat do galerie"

msgid "Browse, filter and prune the site-wide activity/audit log."
msgstr "Procházejte, filtrujte a čistěte celostránkový protokol aktivit / auditu."

msgid "Admin Columns"
msgstr "Sloupce administrace"

msgid "Customize the columns shown in admin list tables for posts, pages, media, comments and users."
msgstr "Přizpůsobte sloupce zobrazené v seznamech administrace pro příspěvky, stránky, média, komentáře a uživatele."

msgid "Customize the WordPress admin menu, admin bar, login screen and more."
msgstr "Přizpůsobte administrační menu WordPressu, admin lištu, přihlašovací obrazovku a další."

msgid "AI chat widget with knowledge base (RAG), FAQ, human handoff, blog auto-generation and multi-provider support (Claude, OpenAI, DeepSeek)."
msgstr "AI chatovací widget se znalostní bází (RAG), FAQ, předáním člověku, automatickým generováním blogu a podporou více poskytovatelů (Claude, OpenAI, DeepSeek)."

msgid "Serve a markdown version of your content for AI bots via /llms.txt and ?format=markdown, with a local (non-AI) conversion and access log."
msgstr "Poskytujte verzi obsahu v markdownu pro AI boty přes /llms.txt a ?format=markdown, s lokálním (ne-AI) převodem a protokolem přístupů."

msgid "Temporary controlled access to files, database and shell for a remote AI agent (Claude Code, Codex, or similar). Access is granted once from the dashboard for a limited time, generates a URL + strong password, and is auto-revoked on expiry."
msgstr "Dočasný řízený přístup k souborům, databázi a shellu pro vzdáleného AI agenta (Claude Code, Codex nebo podobný). Přístup se z nástěnky udělí jednorázově na omezenou dobu, vygeneruje URL + silné heslo a po vypršení se automaticky odvolá."

msgid "Auto Image Upload"
msgstr "Automatické nahrávání obrázků"

msgid "Automatically sideload external images pasted into the editor (from another site or data: URLs) into the media library."
msgstr "Automaticky stahujte externí obrázky vložené do editoru (z jiného webu nebo z data: URL) do knihovny médií."

msgid "Auto Unpublish"
msgstr "Automatické zrušení publikace"

msgid "Schedule posts to be automatically switched back to draft at a chosen date and time."
msgstr "Naplánujte automatické přepnutí příspěvků zpět na koncept ve zvolený datum a čas."

msgid "Detect bots by User-Agent pattern and rate-limit frontend requests."
msgstr "Detekujte boty podle vzoru User-Agent a omezujte rychlost frontendových požadavků."

msgid "Classic Editor"
msgstr "Klasický editor"

msgid "Replace the block editor with the classic editor for selected post types."
msgstr "Nahraďte blokový editor klasickým editorem pro vybrané typy obsahu."

msgid "Classic Widgets"
msgstr "Klasické widgety"

msgid "Restore the classic widgets screen by disabling the block-based widgets editor."
msgstr "Obnovte klasickou obrazovku widgetů vypnutím blokového editoru widgetů."

msgid "Clean Profiles"
msgstr "Vyčištění profilů"

msgid "Hide selected sections and fields on the user profile screen to simplify it."
msgstr "Skryjte vybrané sekce a pole na obrazovce profilu uživatele pro zjednodušení."

msgid "Run PHP, HTML, CSS or JS snippets in the header or footer of your site."
msgstr "Spouštějte úryvky kódu PHP, HTML, CSS nebo JS v hlavičce nebo patičce vašeho webu."

msgid "Central broker connection to the central app: registered sites, SSO tokens and a synchronization log."
msgstr "Připojení k centrálnímu brokeru centrální aplikace: registrované weby, SSO tokeny a synchronizační protokol."

msgid "Inspect and manage WP-Cron scheduled events."
msgstr "Prohlížejte a spravujte naplánované události WP-Cron."

msgid "PageSpeed score, recent activity and quick tasks/notes."
msgstr "Skóre PageSpeed, nedávná aktivita a rychlé úkoly / poznámky."

msgid "Debug Mode"
msgstr "Režim ladění"

msgid "Inspect the status of WordPress debug constants and read the debug log."
msgstr "Zjistěte stav ladicích konstant WordPressu a čtěte ladicí protokol."

msgid "Disable Auto Updates"
msgstr "Vypnout automatické aktualizace"

msgid "Disable automatic updates for WordPress core, plugins, themes and translations."
msgstr "Vypněte automatické aktualizace jádra WordPressu, pluginů, šablon a překladů."

msgid "Disable Video Uploads"
msgstr "Zakázat nahrávání videí"

msgid "Prevent video files from being uploaded to the media library."
msgstr "Zabraňte nahrávání video souborů do knihovny médií."

msgid "Manage protected downloadable files (e.g. PDFs) served via a tokenized link, backed by the standard WordPress media library."
msgstr "Spravujte chráněné soubory ke stažení (např. PDF) poskytované přes odkaz s tokenem, postavené na standardní knihovně médií WordPressu."

msgid "Duplicate Menu"
msgstr "Duplikovat menu"

msgid "Duplicate an existing navigation menu including all of its items."
msgstr "Duplikujte existující navigační menu včetně všech jeho položek."

msgid "Duplicate Post"
msgstr "Duplikovat příspěvek"

msgid "Duplicate posts, pages and custom post types with one click from the post list."
msgstr "Duplikujte příspěvky, stránky a vlastní typy obsahu jedním kliknutím ze seznamu příspěvků."

msgid "Elementor Import"
msgstr "Import Elementoru"

msgid "Import an Elementor template from a JSON or ZIP upload as a new draft page."
msgstr "Importujte šablonu Elementoru z nahraného souboru JSON nebo ZIP jako novou stránku v konceptu."

msgid "Email Health"
msgstr "Stav e-mailů"

msgid "Send a test email to verify outgoing mail works and record the last result."
msgstr "Odešlete testovací e-mail pro ověření funkčnosti odchozí pošty a zaznamenejte poslední výsledek."

msgid "Record every outgoing wp_mail() send, successful or failed."
msgstr "Zaznamenávejte každé odchozí odeslání wp_mail(), úspěšné i neúspěšné."

msgid "Show a popup with an email capture form when a visitor is about to leave the page."
msgstr "Zobrazte vyskakovací okno s formulářem pro sběr e-mailů, když se návštěvník chystá opustit stránku."

msgid "Export Posts"
msgstr "Export příspěvků"

msgid "Export post data to CSV, JSON or TXT from row actions and bulk actions."
msgstr "Exportujte data příspěvků do CSV, JSON nebo TXT z akcí řádku a hromadných akcí."

msgid "Export Users"
msgstr "Export uživatelů"

msgid "Export user data to CSV, JSON or TXT from row actions, bulk actions and profiles."
msgstr "Exportujte data uživatelů do CSV, JSON nebo TXT z akcí řádku, hromadných akcí a profilů."

msgid "External Permalinks"
msgstr "Externí trvalé odkazy"

msgid "Point posts, pages or custom post types to an external URL instead of the default permalink."
msgstr "Nasměrujte příspěvky, stránky nebo vlastní typy obsahu na externí URL místo výchozího trvalého odkazu."

msgid "Browse and manage server files through the embedded Tiny File Manager. Access is restricted to an explicit whitelist of administrators."
msgstr "Procházejte a spravujte soubory na serveru přes vestavěný Tiny File Manager. Přístup je omezen na explicitní seznam povolených administrátorů."

msgid "Organize media library attachments into folders using a taxonomy - no filesystem changes."
msgstr "Uspořádejte přílohy knihovny médií do složek pomocí taxonomie – bez změn v souborovém systému."

msgid "Send Google review request emails after orders or reservations and track delivery stats."
msgstr "Odesílejte e-maily s žádostí o Google recenzi po objednávkách nebo rezervacích a sledujte statistiky doručení."

msgid "Guide"
msgstr "Průvodce"

msgid "A getting-started checklist that tracks setup progress for the site."
msgstr "Kontrolní seznam pro začátek, který sleduje průběh nastavení webu."

msgid "Hide Admin Bar"
msgstr "Skrýt admin lištu"

msgid "Hide the WordPress admin bar on the frontend for selected roles."
msgstr "Skryjte admin lištu WordPressu na frontendu pro vybrané role."

msgid "Compress media library images and generate WebP copies, with originals always kept as backups."
msgstr "Komprimujte obrázky v knihovně médií a generujte kopie ve formátu WebP, přičemž originály se vždy uchovávají jako zálohy."

msgid "Indexing Notice"
msgstr "Upozornění na indexaci"

msgid "Show an admin bar warning when search engines are discouraged from indexing the site."
msgstr "Zobrazte v admin liště varování, když je vyhledávačům odrazováno od indexace webu."

msgid "Display an Instagram feed on the frontend, synchronized through the Content Sync broker (no Meta API credentials on this site)."
msgstr "Zobrazte na frontendu Instagram feed synchronizovaný přes broker Content Sync (bez přihlašovacích údajů Meta API na tomto webu)."

msgid "Link Manager"
msgstr "Správce odkazů"

msgid "Control how external links behave: add rel attributes, open in new tab, arrow icon and speculative loading."
msgstr "Ovládejte chování externích odkazů: přidání rel atributů, otevírání v novém panelu, ikonu šipky a spekulativní načítání."

msgid "Put the site into maintenance or coming soon mode with a customisable page while you work."
msgstr "Přepněte web do režimu údržby nebo brzy spustíme s přizpůsobitelnou stránkou, zatímco pracujete."

msgid "Replace an image or file in the media library by uploading a new one, keeping the same URL."
msgstr "Nahraďte obrázek nebo soubor v knihovně médií nahráním nového se zachováním stejné URL."

msgid "Media Trash"
msgstr "Koš médií"

msgid "Send deleted media files to the trash instead of deleting them permanently."
msgstr "Přesouvejte smazané soubory médií do koše místo jejich trvalého odstranění."

msgid "Menu Visibility"
msgstr "Viditelnost menu"

msgid "Show or hide individual navigation menu items based on the visitor's login status."
msgstr "Zobrazujte nebo skrývejte jednotlivé položky navigačního menu podle stavu přihlášení návštěvníka."

msgid "Public notice board with downloadable documents, categories and email subscriptions."
msgstr "Veřejná nástěnka se stahovatelnými dokumenty, kategoriemi a e-mailovými odběry."

msgid "Manage branch locations, weekly opening hours and exceptions, with a live open/closed status API. (Scope note: legacy shortcodes/map widgets are intentionally not ported yet - CRUD + status API only.)"
msgstr "Spravujte pobočky, týdenní otevírací dobu a výjimky s živým API stavu otevřeno/zavřeno. (Poznámka k rozsahu: starší shortcody / widgety map záměrně zatím nejsou přeneseny – pouze CRUD + API stavu.)"

msgid "Sample and report server-side page response times."
msgstr "Vzorkujte a reportujte doby odezvy stránek na straně serveru."

msgid "Read-only database/content health checks with a small whitelist of safe cleanup actions and score history."
msgstr "Kontroly stavu databáze / obsahu jen pro čtení s malým seznamem povolených bezpečných čisticích akcí a historií skóre."

msgid "Pixel & Tag Manager"
msgstr "Správce pixelů a tagů"

msgid "Add tracking pixels and tags for Google Analytics, Facebook Pixel and Pinterest to the site head."
msgstr "Přidejte do hlavičky webu sledovací pixely a tagy pro Google Analytics, Facebook Pixel a Pinterest."

msgid "Create and target on-site popups with delay, scroll or page-load triggers and track impressions/clicks."
msgstr "Vytvářejte a cílete vyskakovací okna na webu se spouštěči podle prodlevy, scrollování nebo načtení stránky a sledujte zobrazení/kliknutí."

msgid "Post Gallery"
msgstr "Galerie příspěvku"

msgid "Attach an image gallery to any post or page with a grid layout and lightbox."
msgstr "Připojte k libovolnému příspěvku nebo stránce galerii obrázků s mřížkovým rozvržením a lightboxem."

msgid "Post ID Display"
msgstr "Zobrazení ID příspěvku"

msgid "Show the post ID in the row actions of post list tables."
msgstr "Zobrazte ID příspěvku v akcích řádku v seznamech příspěvků."

msgid "Post Type Order"
msgstr "Řazení typů obsahu"

msgid "Reorder posts, pages and custom post types with drag and drop in the admin list tables."
msgstr "Přeuspořádejte příspěvky, stránky a vlastní typy obsahu přetažením v administračních seznamech."

msgid "Switch the post type of your content to reorganise and reuse existing posts and pages."
msgstr "Přepněte typ obsahu, abyste reorganizovali a znovu využili existující příspěvky a stránky."

msgid "Web push (VAPID) subscriptions and notifications, with delivery/click event tracking."
msgstr "Odběry a oznámení web push (VAPID) se sledováním událostí doručení/kliknutí."

msgid "Quick Add Post"
msgstr "Rychlé přidání příspěvku"

msgid "Add a New button to the block editor toolbar for quickly creating another post."
msgstr "Přidejte do panelu nástrojů blokového editoru tlačítko Nový pro rychlé vytvoření dalšího příspěvku."

msgid "Quick Image"
msgstr "Rychlý obrázek"

msgid "Change the featured image straight from the posts and pages list tables via a thumbnail column."
msgstr "Měňte náhledový obrázek přímo ze seznamů příspěvků a stránek přes sloupec s náhledem."

msgid "Redirect 404 to Homepage"
msgstr "Přesměrování 404 na domovskou stránku"

msgid "Redirect 404 error pages to the homepage with a 301 redirect."
msgstr "Přesměrujte stránky s chybou 404 na domovskou stránku pomocí přesměrování 301."

msgid "Aggregate Google, Facebook and Mapy.cz reviews through the Content Sync broker - no local scraping or API keys on this site."
msgstr "Agregujte recenze z Google, Facebooku a Mapy.cz přes broker Content Sync – žádné lokální scrapování ani API klíče na tomto webu."

msgid "Roll back an installed plugin or theme to an older version pulled from WordPress.org."
msgstr "Vraťte nainstalovaný plugin nebo šablonu na starší verzi staženou z WordPress.org."

msgid "Login protection, IP bans, country blocklist, custom login URL, .htaccess hardening and security headers."
msgstr "Ochrana přihlášení, blokování IP, blokování zemí, vlastní přihlašovací URL, zabezpečení .htaccess a bezpečnostní hlavičky."

msgid "Internal system for tracking service/change requests for the site, with media library attachments."
msgstr "Interní systém pro sledování požadavků na služby / změny webu s přílohami z knihovny médií."

msgid "Route outgoing mail through SMTP or the Brevo API and keep a delivery log."
msgstr "Směrujte odchozí poštu přes SMTP nebo Brevo API a veďte protokol o doručení."

msgid "Search and import images from Pexels, Pixabay, Unsplash, Flickr, Mapillary, Giphy and Openverse straight into the media library."
msgstr "Vyhledávejte a importujte obrázky z Pexels, Pixabay, Unsplash, Flickr, Mapillary, Giphy a Openverse přímo do knihovny médií."

msgid "SVG Upload"
msgstr "Nahrávání SVG"

msgid "Allow SVG files to be uploaded to the media library, sanitized on the way in for selected roles."
msgstr "Povolte nahrávání souborů SVG do knihovny médií, sanitizovaných při nahrávání, pro vybrané role."

msgid "Sign in via Google, Facebook or Apple through the central app as an OAuth proxy."
msgstr "Přihlaste se přes Google, Facebook nebo Apple prostřednictvím centrální aplikace jako OAuth proxy."

msgid "Top Bar"
msgstr "Horní lišta"

msgid "Show a scheduled announcement bar at the top of the site with custom colours."
msgstr "Zobrazte v horní části webu naplánovanou oznamovací lištu s vlastními barvami."

msgid "User Last Login"
msgstr "Poslední přihlášení uživatele"

msgid "Record each user's last login time and show it as a column on the Users screen."
msgstr "Zaznamenávejte čas posledního přihlášení každého uživatele a zobrazte jej jako sloupec na obrazovce Uživatelé."

msgid "Instantly switch between user accounts to test roles and troubleshoot, then switch straight back."
msgstr "Okamžitě přepínejte mezi uživatelskými účty pro testování rolí a řešení problémů a poté se rovnou přepněte zpět."

msgid "Check installed plugins, themes and WordPress core for known vulnerabilities and outdated versions using WordPress.org, plus real CVE data from WPScan when an API key is provided."
msgstr "Zkontrolujte nainstalované pluginy, šablony a jádro WordPressu na známé zranitelnosti a zastaralé verze pomocí WordPress.org, plus reálná data CVE z WPScan, pokud je poskytnut API klíč."

msgid "Grid view"
msgstr "Zobrazení mřížky"

msgid "List view"
msgstr "Zobrazení seznamu"

msgid "Comments"
msgstr "Komentáře"

msgid "Default (native column)"
msgstr "Výchozí (nativní sloupec)"

msgid "Custom field (meta)"
msgstr "Vlastní pole (meta)"

msgid "Taxonomy"
msgstr "Taxonomie"

msgid "ID"
msgstr "ID"

msgid "Key of an existing column, e.g. title, author, date, categories."
msgstr "Klíč existujícího sloupce, např. title, author, date, categories."

msgid "Custom field (post/user/comment meta) key."
msgstr "Klíč vlastního pole (meta příspěvku/uživatele/komentáře)."

msgid "Taxonomy slug, e.g. category, post_tag."
msgstr "Identifikátor (slug) taxonomie, např. category, post_tag."

msgid "Any unique column key."
msgstr "Libovolný unikátní klíč sloupce."

msgid "Move up"
msgstr "Posunout nahoru"

msgid "Move down"
msgstr "Posunout dolů"

msgid "Column title"
msgstr "Název sloupce"

msgid "e.g. 80px"
msgstr "např. 80px"

msgid "Disable column"
msgstr "Vypnout sloupec"

msgid "Enable column"
msgstr "Zapnout sloupec"

msgid "Delete column"
msgstr "Smazat sloupec"

msgid "No custom columns configured yet for this content type — the native columns are shown unchanged. Add a column below to relabel, reorder, hide or add one."
