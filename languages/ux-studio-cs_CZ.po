#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "A settings export of UX Studio, up to 2 MB. Nothing is saved yet: you will see what it would change first."
msgstr "Export nastavení UX Studia, nejvýš 2 MB. Zatím se nic neukládá: nejdřív uvidíte, co by změnil."

#: build/index.21ca1d77df8d20b20d5e.js:32
#: build/index.21ca1d77df8d20b20d5e.js:33
msgid "Checking the file…"
msgstr "Kontroluji soubor…"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "The file"
msgstr "Soubor"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Choose another file"
msgstr "Vybrat jiný soubor"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "From site"
msgstr "Z webu"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "The file holds secret values (API keys, passwords) encrypted with a passphrase. Type it to include them in the preview, or leave it and import without them."
msgstr "Soubor obsahuje tajné hodnoty (API klíče, hesla) zašifrované heslem. Zadejte ho, aby se zahrnuly do náhledu, nebo ho nechte být a importujte bez nich."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "This server has no libsodium (the PHP sodium extension), so the secrets cannot be opened here."
msgstr "Tento server nemá libsodium (rozšíření PHP sodium), takže tajné hodnoty tady nelze otevřít."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Open the secrets"
msgstr "Otevřít tajné hodnoty"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "The secrets were opened. They are never shown here, only whether they differ."
msgstr "Tajné hodnoty byly otevřeny. Nikdy se tu nezobrazují, jen zda se liší."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Safety measures"
msgstr "Bezpečnostní opatření"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "None of the rules below had to hold anything back for this file."
msgstr "Žádné z níže uvedených pravidel pro tento soubor nemuselo nic zadržet."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "All rules that always apply to an import"
msgstr "Všechna pravidla, která platí pro každý import"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "How to import"
msgstr "Jak importovat"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Merge"
msgstr "Sloučit"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "recommended"
msgstr "doporučeno"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Overwrites only the settings the file lists. Everything else stays as it is."
msgstr "Přepíše jen nastavení, která soubor uvádí. Vše ostatní zůstane, jak je."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Replace the whole setting of a module"
msgstr "Nahradit celé nastavení modulu"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Settings the file does not mention go back to their defaults."
msgstr "Nastavení, která soubor neuvádí, se vrátí na výchozí hodnoty."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Switch modules on and off as in the file"
msgstr "Zapnout a vypnout moduly podle souboru"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Off by default. Switching on goes through the same check as the Modules screen (a plugin that does the same job can refuse it)."
msgstr "Ve výchozím stavu vypnuto. Zapnutí projde stejnou kontrolou jako obrazovka Moduly (plugin, který dělá totéž, ho může odmítnout)."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Also switch off modules that hold data here"
msgstr "Vypnout i moduly, které tady drží data"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Forms, redirects, snippets and the like stay on unless you tick this. Their data is never deleted."
msgstr "Formuláře, přesměrování, snippety a podobné moduly zůstanou zapnuté, dokud to nezaškrtnete. Jejich data se nikdy nemažou."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Allow switching on maintenance mode"
msgstr "Povolit zapnutí režimu údržby"

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "Maintenance mode hides the site from visitors. An import never does that unless you tick this."
msgstr "Režim údržby skryje web před návštěvníky. Import to nikdy neudělá, pokud to nezaškrtnete."

#: build/index.21ca1d77df8d20b20d5e.js:32
msgid "What it would change"
msgstr "Co by se změnilo"

#. translators: 1: changes, 2: settings without change.
#: build/index.21ca1d77df8d20b20d5e.js:33
msgid "%1$d changes, %2$d without change"
msgstr "%1$d změn, %2$d beze změny"

#. translators: 1: modules chosen, 2: changes in them.
#: build/index.21ca1d77df8d20b20d5e.js:34
msgid "Chosen: %1$d modules, %2$d changes."
msgstr "Vybráno: %1$d modulů, %2$d změn."

#: build/index.21ca1d77df8d20b20d5e.js:34
msgid "Replace the whole setting of the modules?"
msgstr "Nahradit celé nastavení modulů?"

#: build/index.21ca1d77df8d20b20d5e.js:34
msgid "Yes, replace"
msgstr "Ano, nahradit"

#: build/index.21ca1d77df8d20b20d5e.js:34
msgid "In every module you import, the settings the file does not mention go back to their defaults. Connections and keys that never travel stay as they are. You can still undo the import for 30 days."
msgstr "V každém importovaném modulu se nastavení, která soubor neuvádí, vrátí na výchozí hodnoty. Připojení a klíče, které se nikdy nepřenášejí, zůstanou, jak jsou. Import můžete stále 30 dní vrátit."

#: build/index.21ca1d77df8d20b20d5e.js:34
msgid "Import now?"
msgstr "Importovat teď?"

#: build/index.21ca1d77df8d20b20d5e.js:34
msgid "Importing…"
msgstr "Importuji…"

#. translators: 1: modules, 2: changes.
#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "%1$d modules and %2$d changes will be saved."
msgstr "Uloží se %1$d modulů a %2$d změn."

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Mode: replace the whole setting."
msgstr "Režim: nahradit celé nastavení."

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Mode: merge."
msgstr "Režim: sloučit."

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "A snapshot is taken first, so you can undo the import for 30 days."
msgstr "Nejdřív se pořídí snímek, takže import můžete 30 dní vrátit."

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Undo the last import?"
msgstr "Vrátit poslední import?"

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Undoing…"
msgstr "Vracím…"

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "The settings of the modules the import touched, the list of modules switched on, and the content the import created or changed go back to how they were just before it. Changes made since then in those modules are lost."
msgstr "Nastavení modulů, kterých se import dotkl, seznam zapnutých modulů a obsah, který import vytvořil nebo změnil, se vrátí do stavu těsně před ním. Změny provedené od té doby v těchto modulech se ztratí."

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Or paste the text of the file"
msgstr "Nebo vložte text souboru"

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Check the text"
msgstr "Zkontrolovat text"

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "will be switched on"
msgstr "bude zapnut"

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "will be switched off"
msgstr "bude vypnut"

#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "overlap"
msgstr "překryv"

#. translators: %s: module name.
#: build/index.21ca1d77df8d20b20d5e.js:35
msgid "Details: %s"
msgstr "Podrobnosti: %s"

#. translators: %s: names of plugins.
#: build/index.21ca1d77df8d20b20d5e.js:36
msgid "Switch it on although it overlaps with %s"
msgstr "Zapnout, i když se překrývá s %s"

#: build/index.21ca1d77df8d20b20d5e.js:36
msgid "Now"
msgstr "Nyní"

#: build/index.21ca1d77df8d20b20d5e.js:36
msgid "After import"
msgstr "Po importu"

#: build/index.21ca1d77df8d20b20d5e.js:36
msgid "sensitive"
msgstr "citlivé"

#: build/index.21ca1d77df8d20b20d5e.js:36
msgid "a different secret value"
msgstr "jiná tajná hodnota"

#. translators: 1: new items, 2: updated items, 3: unchanged items.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "%1$d new, %2$d updated, %3$d unchanged"
msgstr "%1$d nových, %2$d upravených, %3$d beze změny"

#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "same"
msgstr "stejné"

#. translators: %d: number of items.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "…and %d more"
msgstr "…a dalších %d"

#. translators: %s: name of a setting.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "%s: the image is not in the media library of this site, so it was left unset."
msgstr "%s: obrázek není v knihovně médií tohoto webu, proto zůstal nenastavený."

#. translators: 1: setting name, 2: number of choices.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "%1$s: %2$d choices do not exist on this site and were left out."
msgstr "%1$s: %2$d voleb na tomto webu neexistuje a byly vynechány."

#. translators: %s: names of settings.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "Not transferred (belongs to one site): %s."
msgstr "Nepřenáší se (patří k jednomu webu): %s."

#. translators: %s: names of keys.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "Not known to this version, skipped: %s."
msgstr "Tato verze je nezná, přeskočeno: %s."

#. translators: %s: names of settings.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "To fill in by hand: %s."
msgstr "Vyplnit ručně: %s."

#. translators: %d: number of settings.
#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "%d setting is already the same."
msgid_plural "%d settings are already the same."
msgstr[0] "%d nastavení je už stejné."
msgstr[1] "%d nastavení jsou už stejná."
msgstr[2] "%d nastavení je už stejných."

#: build/index.21ca1d77df8d20b20d5e.js:37
msgid "The new login address did not show the login form, so the Security settings were put back to what they were. Nobody was locked out."
msgstr "Nová přihlašovací adresa neukázala přihlašovací formulář, proto se nastavení Zabezpečení vrátila do původního stavu. Nikdo nebyl zamknut."

#. translators: %s: the new login address.
#: build/index.21ca1d77df8d20b20d5e.js:38
msgid "The new login address %s is saved, but wp-login.php stays open until you open the new address and confirm it."
msgstr "Nová přihlašovací adresa %s je uložená, ale wp-login.php zůstává otevřený, dokud novou adresu neotevřete a nepotvrdíte."

#: build/index.21ca1d77df8d20b20d5e.js:38
msgid "Open the Security module"
msgstr "Otevřít modul Zabezpečení"

#: build/index.21ca1d77df8d20b20d5e.js:38
msgid "Login check: wp-login.php is reachable."
msgstr "Kontrola přihlášení: wp-login.php je dostupný."

#: build/index.21ca1d77df8d20b20d5e.js:38
msgid "Result of the import"
msgstr "Výsledek importu"

#. translators: 1: modules done, 2: skipped, 3: failed.
#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "%1$d done, %2$d skipped, %3$d failed"
msgstr "%1$d hotovo, %2$d přeskočeno, %3$d selhalo"

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "done"
msgstr "hotovo"

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "partly done"
msgstr "částečně hotovo"

#. translators: %d: number of settings saved.
#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "%d setting saved"
msgid_plural "%d settings saved"
msgstr[0] "%d nastavení uloženo"
msgstr[1] "%d nastavení uložena"
msgstr[2] "%d nastavení uloženo"

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "switched on"
msgstr "zapnuto"

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "switched off"
msgstr "vypnuto"

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "A snapshot was taken before the import. You can undo it for 30 days."
msgstr "Před importem byl pořízen snímek. Můžete ho 30 dní vrátit."

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "Import another file"
msgstr "Importovat další soubor"

#: build/index.21ca1d77df8d20b20d5e.js:39
msgid "Failed to load the list of modules."
msgstr "Nepodařilo se načíst seznam modulů."

#: build/index.21ca1d77df8d20b20d5e.js:39
#: build/index.21ca1d77df8d20b20d5e.js:43
msgid "Export and import"
msgstr "Export a import"

#: build/index.21ca1d77df8d20b20d5e.js:39
