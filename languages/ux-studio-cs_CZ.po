msgstr "Soubor není platný JSON."

#: includes/Core/Transfer/Envelope.php:166
msgid "The file is JSON, but not a settings export of UX Studio."
msgstr "Soubor je JSON, ale ne export nastavení UX Studia."

#: includes/Core/Transfer/Envelope.php:188
msgid "This is not a settings export of UX Studio (the \"format\" field is missing or different)."
msgstr "Toto není export nastavení UX Studia (pole \"format\" chybí nebo je jiné)."

#: includes/Core/Transfer/Envelope.php:192
