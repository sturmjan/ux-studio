#: includes/Modules/Redirects/Repository.php:658
msgid "Temporary redirect: search engines keep the old URL indexed and do not pass its ranking. Use 301/308 for permanent moves."
msgstr "Dočasné přesměrování: vyhledávače nechají starou URL v indexu a nepředají její hodnocení. Pro trvalý přesun použijte 301/308."

#: includes/Modules/Redirects/Repository.php:661
msgid "Target is not a known post or page - verify it answers 200 (test-url with live=true)."
msgstr "Cíl není známý příspěvek ani stránka - ověřte, že vrací 200 (test URL s živou kontrolou)."

#: includes/Modules/Redirects/Repository.php:664
msgid "The source URL currently shows live content - the redirect will hide it."
msgstr "Na zdrojové URL je teď živý obsah - přesměrování ho skryje."

#. translators: %d: rule id
#: includes/Modules/Redirects/Repository.php:571
#, php-format
msgid "Another rule (#%d) already handles this source."
msgstr "Tento zdroj už obsluhuje jiné pravidlo (#%d)."

#: includes/Modules/Redirects/Repository.php:573
msgid "Source already has a rule - skipped."
msgstr "Zdroj už má pravidlo - přeskočeno."

#: includes/Modules/Redirects/RestController.php:70
msgid "items must be a non-empty array."
msgstr "items musí být neprázdné pole."

#: includes/Modules/Redirects/RestController.php:149
msgid "CSV is empty."
msgstr "CSV je prázdné."

#: includes/Modules/Redirects/Tester.php:192
msgid "Invalid regular expression - the rule never matches."
msgstr "Neplatný regulární výraz - pravidlo se nikdy neuplatní."

#: includes/Modules/Redirects/Tester.php:199
msgid "The target post is no longer published - pick a new target or switch to 410."
msgstr "Cílový příspěvek už není publikovaný - vyberte nový cíl nebo přepněte na 410."

#: includes/Modules/Redirects/Tester.php:204
msgid "Redirect loop."
msgstr "Smyčka přesměrování."

#. translators: %d: hops
#: includes/Modules/Redirects/Tester.php:214
#, php-format
msgid "Redirect chain with %d hops - each hop loses crawl budget; point straight at the final URL."
msgstr "Řetěz přesměrování s %d kroky - každý krok ubírá crawl budget; směřujte rovnou na konečnou URL."

#: includes/Modules/Redirects/Tester.php:221
msgid "Temporary redirect older than 30 days - if the move is permanent, switch to 301 so the ranking is passed."
msgstr "Dočasné přesměrování starší než 30 dní - pokud je přesun trvalý, přepněte na 301, aby se předalo hodnocení."

#: includes/Modules/Redirects/Tester.php:225
msgid "The source URL has live content again - the redirect hides it. Delete the rule if the page should be reachable."
msgstr "Na zdrojové URL je znovu živý obsah - přesměrování ho skrývá. Pokud má být stránka dostupná, pravidlo smažte."

