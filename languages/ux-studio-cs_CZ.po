msgstr "PHP %s"

#. translators: %s: PHP version.
#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "This website runs on PHP %s. No known security problem with this version."
msgstr "Tento web běží na PHP %s. U této verze není známý žádný bezpečnostní problém."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Unknown server"
msgstr "Neznámý server"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Server"
msgstr "Server"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Cloudflare"
msgstr "Cloudflare"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Detected. Visitor IP addresses are read from the Cloudflare header."
msgstr "Zjištěn. IP adresy návštěvníků se čtou z hlavičky Cloudflare."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Not detected."
msgstr "Nezjištěn."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Reverse proxy"
msgstr "Reverzní proxy"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "The site is behind a reverse proxy. Limiting login attempts stays off until the client IP source is set."
msgstr "Web je za reverzní proxy. Omezení pokusů o přihlášení zůstane vypnuté, dokud se nenastaví zdroj IP adresy klienta."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Active. Comments are switched off on posts and pages only, product reviews keep working."
msgstr "Aktivní. Komentáře se vypínají jen u příspěvků a stránek, hodnocení produktů zůstanou fungovat."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Not installed."
msgstr "Není nainstalován."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Permalinks"
msgstr "Trvalé odkazy"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Pretty permalinks are on."
msgstr "Hezké trvalé odkazy jsou zapnuté."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Plain permalinks. A custom login address is not possible until you choose a pretty structure."
msgstr "Obyčejné trvalé odkazy. Vlastní přihlašovací adresa není možná, dokud nezvolíte hezkou strukturu."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Can be written, so the security rules go there."
msgstr "Dá se zapisovat, takže se bezpečnostní pravidla zapíšou tam."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Cannot be written. The security headers are sent by PHP only."
msgstr "Nedá se zapisovat. Bezpečnostní hlavičky posílá jen PHP."

#: build/631.c85302483897d8f7d1c2.js:3
#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Site logo"
msgstr "Logo webu"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Set. It is shown on the login page."
msgstr "Nastaveno. Zobrazí se na přihlašovací stránce."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Not set yet. The login page keeps the WordPress logo."
msgstr "Zatím nenastaveno. Přihlašovací stránka si nechá logo WordPressu."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "You see every module and its preset first and choose what you want. Nothing is switched on without your tick."
msgstr "Nejdřív uvidíte každý modul s jeho přednastavením a vyberete si, co chcete. Bez vašeho zaškrtnutí se nic nezapne."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "If another plugin already does a job, that item stays off or leaves that one setting out, so nothing is done twice."
msgstr "Pokud určitou práci už dělá jiný plugin, položka zůstane vypnutá nebo vynechá právě to jedno nastavení, takže se nic neděje dvakrát."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Before the first change the current state is saved. \"Undo everything\" at the end puts the modules and settings back."
msgstr "Před první změnou se uloží současný stav. „Vrátit vše zpět“ na konci vrátí moduly i nastavení."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Set up your new website"
msgstr "Nastavte svůj nový web"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "UX Studio can switch on the modules that suit almost every WordPress site and preset them sensibly in a few minutes."
msgstr "UX Studio umí během pár minut zapnout moduly, které se hodí téměř každému webu na WordPressu, a rozumně je přednastavit."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "What the wizard found"
msgstr "Co průvodce zjistil"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Choose the modules"
msgstr "Vybrat moduly"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Confirm the partial overlap first."
msgstr "Nejdřív potvrďte částečný překryv."

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Module already on"
msgstr "Modul už je zapnutý"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Part left out"
msgstr "Část se vynechá"

#: build/index.21ca1d77df8d20b20d5e.js:63
msgid "Optional"
msgstr "Volitelné"

#. translators: %s: plugin names.
#: build/index.21ca1d77df8d20b20d5e.js:64
msgid "Not available: %s already does this job on this site."
msgstr "Není k dispozici: %s už tuto práci na tomto webu dělá."

#. translators: %s: plugin names.
#: build/index.21ca1d77df8d20b20d5e.js:65
msgid "Switch it on although it partly overlaps with %s"
msgstr "Zapnout přesto, že se částečně překrývá s pluginem %s"

#. translators: %s: plugin names.
#: build/index.21ca1d77df8d20b20d5e.js:66
msgid "A module of this item is not switched on because %s already does the same job."
msgstr "Jeden z modulů této položky se nezapne, protože stejnou práci už dělá %s."

#: build/index.21ca1d77df8d20b20d5e.js:66
msgid "What will be set"
msgstr "Co se nastaví"

#. translators: %s: module names.
#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "Modules: %s"
msgstr "Moduly: %s"

#. translators: %s: module name.
#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "%s (already on)"
msgstr "%s (už zapnuto)"

#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "The module is just switched on with its default settings."
msgstr "Modul se jen zapne s výchozím nastavením."

#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "Performance and SEO"
msgstr "Výkon a SEO"

#: build/index.21ca1d77df8d20b20d5e.js:67
#: build/index.21ca1d77df8d20b20d5e.js:71
msgid "Recommended modules"
msgstr "Doporučené moduly"

#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "These modules and presets suit almost every site. Untick what you do not want. Open \"What will be set\" to see every value."
msgstr "Tyto moduly a přednastavení se hodí téměř každému webu. Co nechcete, odškrtněte. Otevřením „Co se nastaví“ uvidíte každou hodnotu."

#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "Select the recommended"
msgstr "Vybrat doporučené"

#: build/index.21ca1d77df8d20b20d5e.js:67
msgid "More options"
msgstr "Další volby"

#. translators: %d: number of selected items.
#: build/index.21ca1d77df8d20b20d5e.js:68
msgid "Set up %d item"
msgid_plural "Set up %d items"
msgstr[0] "Nastavit %d položku"
msgstr[1] "Nastavit %d položky"
msgstr[2] "Nastavit %d položek"

#: build/index.21ca1d77df8d20b20d5e.js:68
msgid "Setup finished"
msgstr "Nastavení dokončeno"

#: build/index.21ca1d77df8d20b20d5e.js:68
msgid "Setting up…"
msgstr "Nastavuje se…"

#: build/index.21ca1d77df8d20b20d5e.js:68
msgid "Please keep this page open. Each item is saved on its own, so a problem in one does not stop the others."
msgstr "Nechte tuto stránku otevřenou. Každá položka se ukládá zvlášť, takže problém v jedné nezastaví ostatní."

#: build/index.21ca1d77df8d20b20d5e.js:68
msgid "Done in part."
msgstr "Hotovo jen částečně."

#. translators: 1: items set up, 2: items skipped, 3: items that failed.
#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "%1$d set up, %2$d skipped, %3$d failed. You can undo everything on the last page."
msgstr "Nastaveno %1$d, přeskočeno %2$d, selhalo %3$d. Vše můžete vrátit zpět na poslední stránce."

#: build/index.21ca1d77df8d20b20d5e.js:69
#: build/index.21ca1d77df8d20b20d5e.js:71
msgid "Login address"
msgstr "Přihlašovací adresa"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "No new login address is waiting for confirmation. The login page stays where it was."
msgstr "Žádná nová přihlašovací adresa nečeká na potvrzení. Přihlašovací stránka zůstává, kde byla."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The login address is confirmed"
msgstr "Přihlašovací adresa je potvrzená"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "wp-login.php is closed now. Log in at the new address and save it."
msgstr "wp-login.php je teď zavřený. Přihlaste se na nové adrese a uložte si ji."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "An e-mail with the address was sent to the site administrator."
msgstr "E-mail s adresou byl odeslán správci webu."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The e-mail with the address could not be sent. Save the address now."
msgstr "E-mail s adresou se nepodařilo odeslat. Uložte si adresu hned teď."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Confirm the new login address"
msgstr "Potvrďte novou přihlašovací adresu"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The login page is moving to a new address. Open it first and check that you see the login form."
msgstr "Přihlašovací stránka se stěhuje na novou adresu. Nejdřív ji otevřete a ověřte, že vidíte přihlašovací formulář."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Open in a new window"
msgstr "Otevřít v novém okně"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Until you confirm, nobody is locked out"
msgstr "Dokud nepotvrdíte, nikdo se nezamkne venku"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The usual wp-login.php stays open until you confirm the new address. After the confirmation it is closed for everybody and an e-mail with the new address is sent to you."
msgstr "Obvyklý wp-login.php zůstává otevřený, dokud novou adresu nepotvrdíte. Po potvrzení se pro všechny zavře a pošleme vám e-mail s novou adresou."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The confirmation has been waiting for more than 24 hours. wp-login.php has been open the whole time."
msgstr "Potvrzení čeká už déle než 24 hodin. wp-login.php byl celou dobu otevřený."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "I saw the login form"
msgstr "Na nové adrese jsem viděl(a) přihlašovací formulář"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The server could not check the address"
msgstr "Server adresu nedokázal ověřit"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "I opened the address in my browser and saw the login form there. Close wp-login.php anyway."
msgstr "Adresu jsem otevřel(a) v prohlížeči a přihlašovací formulář jsem tam viděl(a). Přesto zavřít wp-login.php."

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Close wp-login.php"
msgstr "Zavřít wp-login.php"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Confirm later"
msgstr "Potvrdit později"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Confirm the new address"
msgstr "Potvrdit novou adresu"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "If you confirm later, wp-login.php stays open and a notice in the administration reminds you. You can also come back to this wizard."
msgstr "Když potvrdíte později, wp-login.php zůstane otevřený a upozornění v administraci vám to připomene. Do tohoto průvodce se také můžete vrátit."

#: build/index.21ca1d77df8d20b20d5e.js:50
msgid "The central application did not give this site CAPTCHA keys. The CAPTCHA is not enforced, so logging in works as before. You can add the keys by hand in Security > CAPTCHA."
msgstr "Centrální aplikace webu nedala klíče CAPTCHA. CAPTCHA se nevynucuje, takže přihlášení funguje jako dřív. Klíče můžete doplnit ručně v Zabezpečení > CAPTCHA."

#: build/index.21ca1d77df8d20b20d5e.js:50
msgid "CAPTCHA with keys from the central application"
msgstr "CAPTCHA s klíči z centrální aplikace"

#: build/index.21ca1d77df8d20b20d5e.js:50
msgid "Adds a Cloudflare Turnstile check to the login, registration and lost password forms. The central application gives the site its keys, so you paste nothing. If the keys do not arrive, the check is not enforced and nobody is locked out."
msgstr "Přidá kontrolu Cloudflare Turnstile k formulářům přihlášení, registrace a zapomenutého hesla. Klíče webu dá centrální aplikace, takže nic nevkládáte. Když klíče nedorazí, kontrola se nevynucuje a nikdo se nezamkne venku."

#: build/index.21ca1d77df8d20b20d5e.js:50
msgid "The Security module is off. Switch it on to use the CAPTCHA."
msgstr "Modul Zabezpečení je vypnutý. Pro použití CAPTCHA ho zapněte."

#: build/index.21ca1d77df8d20b20d5e.js:50
msgid "The CAPTCHA is on with keys from the central application."
msgstr "CAPTCHA je zapnutá s klíči z centrální aplikace."

#: build/index.21ca1d77df8d20b20d5e.js:50
#: build/index.21ca1d77df8d20b20d5e.js:71
msgid "Central application"
msgstr "Centrální aplikace"

#: build/index.dc3d7fb3086a456127fe.js:50
msgid "Connect the site to the UX1 central application: one place for all your websites, with monitoring of availability, updates and security."
msgstr "Připojte web k centrální aplikaci UX1: jedno místo pro všechny vaše weby s hlídáním dostupnosti, aktualizací a zabezpečení."

#: build/index.21ca1d77df8d20b20d5e.js:50
msgid "The connection was completed in the central application."
msgstr "Propojení bylo dokončeno v centrální aplikaci."

#. translators: %s: date and time.
#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "It last contacted the site on %s."
msgstr "Naposledy se webu ozvala %s."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "The connection was cancelled in the central application. Nothing is connected. You can try again."
msgstr "Propojení bylo v centrální aplikaci zrušeno. Nic není propojeno. Můžete to zkusit znovu."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "The central application has contacted the site. The connection looks complete."
msgstr "Centrální aplikace se webu ozvala. Propojení vypadá dokončené."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "The central application has not confirmed the connection yet. Try again if you did not finish it there."
msgstr "Centrální aplikace propojení zatím nepotvrdila. Zkuste to znovu, pokud jste ho tam nedokončili."

#: build/index.dc3d7fb3086a456127fe.js:51
msgid "You are taken to the central application, where you log in or create an account. Then you confirm the connection and come back here."
msgstr "Přesměrujeme vás do centrální aplikace, kde se přihlásíte nebo si založíte účet. Pak propojení potvrdíte a vrátíte se sem."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "The site must be reachable from the internet: the central application checks it while connecting."
msgstr "Web musí být dostupný z internetu: centrální aplikace to při propojování ověřuje."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "This switches on Content Sync as a managed site and creates a secret key for it. Administrator sign-in and package installation from the central application stay off."
msgstr "Tím se zapne Synchronizace obsahu jako spravovaný web a vytvoří se pro něj tajný klíč. Přihlášení správce a instalace balíčků z centrální aplikace zůstávají vypnuté."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "This site runs on your computer"
msgstr "Tento web běží na vašem počítači"

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "A central application on the internet cannot reach it, so the connection will fail, unless the central application runs on your computer too."
msgstr "Centrální aplikace na internetu se k němu nedostane, takže propojení selže, pokud centrální aplikace neběží také na vašem počítači."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "Address of the central application"
msgstr "Adresa centrální aplikace"

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "Only https:// addresses work. http:// is accepted for localhost, for testing on your own computer."
msgstr "Fungují jen adresy https://. Adresa http:// se přijímá pro localhost, na zkoušku na vašem počítači."

#: build/index.21ca1d77df8d20b20d5e.js:51
msgid "Check before you continue"
msgstr "Zkontrolujte, než budete pokračovat"

#. translators: %s: error detail.
#: build/index.21ca1d77df8d20b20d5e.js:52
msgid "The site did not answer its own signed test request (%s). The central application will probably not be able to confirm the connection either."
msgstr "Web neodpověděl na vlastní podepsaný zkušební požadavek (%s). Centrální aplikace pravděpodobně také nebude moct propojení potvrdit."

#: build/index.21ca1d77df8d20b20d5e.js:52
msgid "The administration address differs from the site address, so the central application cannot send you back here. Come back to this wizard by hand when you finish."
msgstr "Adresa administrace se liší od adresy webu, takže vás centrální aplikace nemůže poslat zpět sem. Po dokončení se do průvodce vraťte ručně."

#: build/index.21ca1d77df8d20b20d5e.js:52
msgid "Continue anyway"
msgstr "Přesto pokračovat"

#: build/index.21ca1d77df8d20b20d5e.js:52
msgid "Connecting…"
msgstr "Připojuje se…"

#: build/index.21ca1d77df8d20b20d5e.js:52
msgid "Connect to the central application"
msgstr "Připojit k centrální aplikaci"

#: build/index.21ca1d77df8d20b20d5e.js:52
msgid "Skip"
msgstr "Přeskočit"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "Everything was undone"
msgstr "Vše bylo vráceno zpět"

#: build/index.21ca1d77df8d20b20d5e.js:69
msgid "The modules and settings are back the way they were before. If you connected the site to the central application, remove it there as well."
