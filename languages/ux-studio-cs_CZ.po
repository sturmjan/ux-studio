#: includes/Modules/SecurityOptimization/Module.php:989
msgid "Where to disable comments"
msgstr "Kde zakázat komentáře"

#: includes/Modules/SecurityOptimization/Module.php:990
msgid "Everywhere closes comments on all content and removes the comment tools from the admin. For selected post types only those post types are affected."
msgstr "Všude zavře komentáře u veškerého obsahu a odstraní nástroje pro komentáře z administrace. U vybraných typů obsahu se změna týká jen jich."

#: includes/Modules/SecurityOptimization/Module.php:992
msgid "Everywhere"
msgstr "Všude"

#: includes/Modules/SecurityOptimization/Module.php:993
msgid "Only for selected post types"
msgstr "Jen pro vybrané typy obsahu"

#: includes/Core/Migration/Sources/DisableCommentsSource.php:69
#: includes/Modules/SecurityOptimization/Module.php:1001
msgid "Post types without comments"
msgstr "Typy obsahu bez komentářů"

#: includes/Modules/SecurityOptimization/Module.php:1002
msgid "Used when \"Only for selected post types\" is chosen."
msgstr "Použije se, když je zvoleno „Jen pro vybrané typy obsahu“."

#: includes/Core/Migration/Sources/DisableCommentsSource.php:79
#: includes/Modules/SecurityOptimization/Module.php:1010
msgid "Hide existing comments"
msgstr "Skrýt existující komentáře"

#: includes/Modules/SecurityOptimization/Module.php:1011
msgid "Existing comments are hidden on the site but not deleted - switching this off shows them again."
msgstr "Existující komentáře se na webu skryjí, ale nesmažou - po vypnutí se zase zobrazí."

#: includes/Core/Migration/Sources/DisableCommentsSource.php:61
#: includes/Modules/SecurityOptimization/Module.php:1018
msgid "Remove comment tools from the admin"
msgstr "Odstranit nástroje pro komentáře z administrace"

#: includes/Modules/SecurityOptimization/Module.php:1019
msgid "Hides the Comments menu, the Discussion settings page, the dashboard widget, the admin bar bubble and the Recent Comments widget. Applies only when disabling everywhere."
msgstr "Skryje menu Komentáře, stránku nastavení Diskuse, widget na nástěnce, bublinu v admin liště a widget Nejnovější komentáře. Platí jen při zákazu všude."

#: includes/Core/Migration/Sources/DisableCommentsSource.php:62
#: includes/Modules/SecurityOptimization/Module.php:1026
msgid "Block comment endpoints"
msgstr "Zablokovat koncové body komentářů"

#: includes/Modules/SecurityOptimization/Module.php:1027
msgid "Removes the REST API comment routes, XML-RPC comment/pingback methods, the X-Pingback header and comment feeds. Applies only when disabling everywhere."
msgstr "Odstraní komentářové routy REST API, metody XML-RPC pro komentáře a pingbacky, hlavičku X-Pingback a komentářové feedy. Platí jen při zákazu všude."

#: includes/Modules/SecurityOptimization/Module.php:2297
msgid "Comments are disabled."
msgstr "Komentáře jsou zakázané."

