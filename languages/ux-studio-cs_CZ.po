msgstr "Soubor nemá sekci \"modules\"."

#: includes/Core/Transfer/Envelope.php:213
#: includes/Core/Transfer/Envelope.php:218
#: includes/Core/Transfer/Envelope.php:225
msgid "The file has a module entry in a shape that UX Studio does not accept."
msgstr "Soubor obsahuje záznam modulu v podobě, kterou UX Studio nepřijímá."

#: includes/Core/Transfer/Envelope.php:242
msgid "The encrypted block of secrets in the file is damaged."
msgstr "Zašifrovaný blok tajných hodnot v souboru je poškozený."

#. translators: 1: UX Studio version that wrote the file, 2: version on this site.
#: includes/Core/Transfer/Envelope.php:252
msgid "The file was written by UX Studio %1$s, this site runs %2$s. Settings that this version does not know are skipped."
msgstr "Soubor vytvořilo UX Studio %1$s, na tomto webu běží %2$s. Nastavení, která tato verze nezná, se přeskočí."

#: includes/Core/Transfer/Envelope.php:262
msgid "The checksum of the file does not match its content. The file was probably edited by hand or damaged. You can still look at what it would change."
msgstr "Kontrolní součet souboru nesedí s jeho obsahem. Soubor někdo pravděpodobně upravil ručně, nebo je poškozený. Stále se můžete podívat, co by změnil."

#: includes/Core/Transfer/Exporter.php:146
#: build/index.21ca1d77df8d20b20d5e.js:17
msgid "Choose at least one module."
msgstr "Vyberte alespoň jeden modul."

#: includes/Core/Transfer/Exporter.php:156
msgid "This server has no libsodium (the PHP sodium extension), so secrets cannot be encrypted. Export without secrets, or ask your host to enable the extension."
msgstr "Tento server nemá libsodium (rozšíření PHP sodium), takže tajné hodnoty nelze zašifrovat. Exportujte bez tajných hodnot, nebo požádejte hosting o zapnutí rozšíření."

#. translators: %d: minimum length.
#: includes/Core/Transfer/Exporter.php:163
msgid "The passphrase must have at least %d characters."
msgstr "Heslo musí mít alespoň %d znaků."

#: includes/Core/Transfer/Exporter.php:166
msgid "The passphrase is too long."
msgstr "Heslo je příliš dlouhé."

#: includes/Core/Transfer/Exporter.php:167
#: build/index.21ca1d77df8d20b20d5e.js:13
msgid "The two passphrases are not the same."
msgstr "Obě hesla nejsou stejná."

#. translators: %s: name of the content, such as "Code snippets".
#: includes/Core/Transfer/Exporter.php:251
msgid "%s were left out: exporting them needs a user who may add scripts to the site (unfiltered_html)."
msgstr "%s byly vynechány: jejich export vyžaduje uživatele, který smí na web přidávat skripty (unfiltered_html)."

#: includes/Core/Transfer/Exporter.php:273
msgid "The secrets could not be encrypted on this server."
msgstr "Tajné hodnoty se na tomto serveru nepodařilo zašifrovat."

#: includes/Core/Transfer/Exporter.php:276
msgid "None of the chosen modules has a secret value set, so the file has no encrypted block."
msgstr "Žádný z vybraných modulů nemá nastavenou tajnou hodnotu, takže soubor nemá šifrovaný blok."

#: includes/Core/Transfer/Importer.php:87
msgid "Content-Security-Policy is never switched to Enforce by an import; at most to the policy test (report only)."
msgstr "Import nikdy nepřepne Content-Security-Policy na Enforce, nejvýš na test politiky (jen hlášení)."

#: includes/Core/Transfer/Importer.php:88
msgid "A custom login address is saved in two steps: wp-login.php stays open until you open the new address and confirm it."
msgstr "Vlastní přihlašovací adresa se ukládá ve dvou krocích: wp-login.php zůstává otevřený, dokud novou adresu neotevřete a nepotvrdíte."

#: includes/Core/Transfer/Importer.php:89
msgid "Two-factor login is switched on only if you have already set it up for your own account."
msgstr "Dvoufázové přihlášení se zapne jen tehdy, když už máte nastavené vlastní."

#: includes/Core/Transfer/Importer.php:90
msgid "Country blocks are imported only if your IP address is on the firewall allowlist."
msgstr "Blokování zemí se importuje jen tehdy, když je vaše IP adresa na allowlistu firewallu."

#: includes/Core/Transfer/Importer.php:91
msgid "The menu lock is switched on only if it keeps UX Studio, Plugins, Users and Settings open for you."
msgstr "Zámek menu se zapne jen tehdy, když vám nechá otevřené UX Studio, Pluginy, Uživatele a Nastavení."

#: includes/Core/Transfer/Importer.php:92
msgid "Maintenance mode is never switched on by an import unless you tick the extra box."
msgstr "Režim údržby import nikdy nezapne, pokud nezaškrtnete zvláštní volbu."

#: includes/Core/Transfer/Importer.php:93
msgid "Code (custom CSS, scripts, snippets) is imported only if you may add scripts to the site (unfiltered_html). Snippets arrive switched off."
msgstr "Kód (vlastní CSS, skripty, snippety) se importuje jen tehdy, když smíte na web přidávat skripty (unfiltered_html). Snippety přijdou vypnuté."

#: includes/Core/Transfer/Importer.php:94
msgid "Redirecting to HTTPS is switched on only when you are on HTTPS now; CAPTCHA only when this site has its own CAPTCHA keys."
msgstr "Přesměrování na HTTPS se zapne jen tehdy, když jste teď na HTTPS; CAPTCHA jen tehdy, když má web vlastní klíče CAPTCHA."

#: includes/Core/Transfer/Importer.php:95
msgid "Everything is saved through the module itself, after a snapshot you can undo for 30 days."
msgstr "Vše se ukládá přes samotný modul, po snímku, který můžete 30 dní vrátit."

#: includes/Core/Transfer/Importer.php:156
msgid "The file has encrypted secrets, but this server has no libsodium (the PHP sodium extension), so they cannot be opened. You can import without them."
msgstr "Soubor obsahuje zašifrované tajné hodnoty, ale tento server nemá libsodium (rozšíření PHP sodium), takže je nelze otevřít. Můžete importovat bez nich."

#: includes/Core/Transfer/Importer.php:161
msgid "Too many wrong passphrases. Wait a few minutes and try again."
msgstr "Příliš mnoho špatných hesel. Počkejte několik minut a zkuste to znovu."

#: includes/Core/Transfer/Importer.php:166
msgid "The passphrase is wrong, or the encrypted block of the file is damaged."
msgstr "Heslo je špatné, nebo je zašifrovaný blok souboru poškozený."

#: includes/Core/Transfer/Importer.php:309
msgid "This module does not exist on this site, so it is skipped."
msgstr "Tento modul na tomto webu neexistuje, proto se přeskočí."

#: includes/Core/Transfer/Importer.php:462
msgid "The module is off, and saving its settings also changes files or schedules. Its settings are not imported; switch the module on (or tick \"Switch modules on and off as in the file\") and import again."
msgstr "Modul je vypnutý a uložení jeho nastavení mění i soubory nebo plány. Jeho nastavení se neimportují; zapněte modul (nebo zaškrtněte \"Zapnout a vypnout moduly podle souboru\") a importujte znovu."

#. translators: %s: plugin name.
#: includes/Core/Transfer/Importer.php:476
msgid "This site does not have %s, which the settings of this module work with."
msgstr "Tento web nemá %s, se kterým nastavení tohoto modulu pracují."

#: includes/Core/Transfer/Importer.php:485
msgid "It cannot be switched on: %s already does the same job on this site."
msgstr "Nelze zapnout: %s už na tomto webu dělá totéž."

#: includes/Core/Transfer/Importer.php:486
msgid "It overlaps with %s. Confirm to switch it on anyway."
msgstr "Překrývá se s %s. Potvrďte, pokud ho chcete přesto zapnout."

#: includes/Core/Transfer/Importer.php:491
msgid "The file has this module off, but it holds data here, so it stays on. Tick \"Also switch off modules that hold data\" to switch it off."
msgstr "V souboru je tento modul vypnutý, ale tady drží data, proto zůstane zapnutý. Pro vypnutí zaškrtněte \"Vypnout i moduly, které tady drží data\"."

#: includes/Core/Transfer/Importer.php:499
msgid "Skipped: this content can only be imported by a user who may add scripts to the site (unfiltered_html)."
msgstr "Přeskočeno: tento obsah může importovat jen uživatel, který smí na web přidávat skripty (unfiltered_html)."

#: includes/Core/Transfer/Importer.php:501
msgid "Skipped: the module is off. Switch it on, then import again to bring its content."
msgstr "Přeskočeno: modul je vypnutý. Zapněte ho a pak importujte znovu, aby se přenesl jeho obsah."

#: includes/Core/Transfer/Importer.php:669
msgid "Choose at least one module to import."
msgstr "Vyberte alespoň jeden modul k importu."

#: includes/Core/Transfer/Importer.php:720
msgid "The module does not exist."
msgstr "Modul neexistuje."

#. translators: %s: plugin names.
#: includes/Core/Transfer/Importer.php:731
msgid "Not switched on: %s overlaps with this module."
msgstr "Nezapnuto: %s se s tímto modulem překrývá."

#: includes/Core/Transfer/Importer.php:751
msgid "The module stayed off, so its settings were not written."
msgstr "Modul zůstal vypnutý, proto se jeho nastavení nezapsala."

#: includes/Core/Transfer/Importer.php:771
msgid "The module was off when the import started, so its content was not imported. Import again now that it is on."
msgstr "Modul byl při začátku importu vypnutý, proto se jeho obsah neimportoval. Importujte znovu, teď když je zapnutý."

#: includes/Core/Transfer/Importer.php:791
#: includes/Core/Transfer/Importer.php:841
msgid "Nothing to change."
msgstr "Není co měnit."

#: includes/Core/Transfer/Importer.php:911
msgid "After the import the new login address did not show the login form, so the Security settings were put back to what they were."
msgstr "Po importu nová přihlašovací adresa neukázala přihlašovací formulář, proto se nastavení Zabezpečení vrátila do původního stavu."

#: includes/Core/Transfer/Importer.php:932
msgid "There is no import to undo (the snapshot is kept for 30 days, and only for the last import)."
msgstr "Není co vracet (snímek se drží 30 dní a jen pro poslední import)."

#: includes/Core/Transfer/Importer.php:944
msgid "some content could not be put back."
msgstr "část obsahu se nepodařilo vrátit."

#: includes/Core/Transfer/ImportRules.php:95
msgid "Skipped: code can only be imported by a user who may add scripts to the site (the unfiltered_html capability)."
msgstr "Přeskočeno: kód může importovat jen uživatel, který smí na web přidávat skripty (oprávnění unfiltered_html)."

