msgstr "Navrhnout cíl"

#. translators: %s: new URL path
#: includes/Modules/Redirects/Module.php:177
#, php-format
msgid "URL changed to %s"
msgstr "URL změněna na %s"

#: includes/Modules/Redirects/Module.php:191
msgid "Redirect automatically when a URL changes"
msgstr "Automaticky přesměrovat při změně URL"

#: includes/Modules/Redirects/Module.php:192
msgid "When a published post or page changes its slug or parent, a 301 from the old URL is created (also for child pages)."
msgstr "Když publikovaný příspěvek nebo stránka změní slug nebo nadřazenou stránku, vytvoří se 301 ze staré URL (i pro podstránky)."

#: includes/Modules/Redirects/Module.php:198
msgid "Keep the query string"
msgstr "Zachovat parametry URL"

#: includes/Modules/Redirects/Module.php:199
msgid "Carries ?utm_source, gclid and similar parameters over to the target so campaign tracking survives the redirect."
msgstr "Přenese ?utm_source, gclid a podobné parametry na cíl, aby měření kampaní přežilo přesměrování."

#: includes/Modules/Redirects/Module.php:205
msgid "Browser cache for permanent redirects (seconds)"
msgstr "Cache prohlížeče pro trvalá přesměrování (sekundy)"

#: includes/Modules/Redirects/Module.php:206
msgid "Browsers cache a 301 forever unless told otherwise. 3600 keeps mistakes fixable; 0 = no caching."
msgstr "Prohlížeče si 301 bez dalšího pokynu pamatují navždy. 3600 nechá chyby opravitelné; 0 = bez cache."

#: includes/Modules/Redirects/Module.php:212
msgid "Count hits per rule"
msgstr "Počítat návštěvy u pravidel"

#: includes/Modules/Redirects/Module.php:213
msgid "Shows which old URLs still get traffic (one small database write per redirect)."
msgstr "Ukáže, které staré URL ještě mají návštěvnost (jeden malý zápis do databáze na přesměrování)."

#: includes/Modules/Redirects/Module.php:219
msgid "Log 404 errors"
msgstr "Zaznamenávat chyby 404"

#: includes/Modules/Redirects/Module.php:220
msgid "Aggregated per URL with hit count and referrer, no IP addresses."
msgstr "Souhrnně po URL s počtem návštěv a odkazující stránkou, bez IP adres."

#: includes/Modules/Redirects/Module.php:226
msgid "Keep 404 entries for (days)"
msgstr "Uchovávat záznamy 404 (dní)"

#: includes/Modules/Redirects/Module.php:227
msgid "Entries not seen for this long are removed. 0 = keep."
msgstr "Záznamy, které se tak dlouho neobjevily, se smažou. 0 = ponechat."

#: includes/Modules/Redirects/Repository.php:607
msgid "Rule not found."
msgstr "Pravidlo nenalezeno."

#: includes/Modules/Redirects/Repository.php:635
msgid "match_type must be \"exact\" or \"regex\"."
msgstr "match_type musí být „exact\" nebo „regex\"."

#: includes/Modules/Redirects/Repository.php:638
msgid "code must be one of 301, 302, 307, 308, 410."
msgstr "code musí být jeden z kódů 301, 302, 307, 308, 410."

#: includes/Modules/Redirects/Repository.php:667
msgid "Source is required."
msgstr "Zdrojová URL je povinná."

#: includes/Core/Migration/Sources/RedirectsSource.php:668
#: includes/Modules/Redirects/Repository.php:670
msgid "Source is not a valid regular expression."
msgstr "Zdroj není platný regulární výraz."

#: includes/Modules/Redirects/Repository.php:686
msgid "Source is not a valid URL or path."
msgstr "Zdroj není platná URL ani cesta."

#: includes/Modules/Redirects/Repository.php:688
msgid "The homepage itself cannot be redirected."
msgstr "Úvodní stránku samotnou nelze přesměrovat."

#: includes/Modules/Redirects/Repository.php:690
msgid "WordPress system paths (wp-admin, wp-login.php, wp-json…) cannot be redirected."
msgstr "Systémové cesty WordPressu (wp-admin, wp-login.php, wp-json…) nelze přesměrovat."

#: includes/Modules/Redirects/Repository.php:705
msgid "target_post_id must be a published, publicly viewable post."
msgstr "target_post_id musí být publikovaný, veřejně zobrazitelný příspěvek."

#: includes/Core/Migration/Sources/RedirectsSource.php:674
#: includes/Modules/Redirects/Repository.php:710
msgid "Target (URL or target_post_id) is required unless code is 410."
msgstr "Cíl (URL nebo target_post_id) je povinný, pokud kód není 410."

#: includes/Modules/Redirects/Repository.php:712
msgid "Protocol-relative targets (//host) are not allowed, use https://."
msgstr "Cíle bez protokolu (//host) nejsou povolené, použijte https://."

#: includes/Modules/Redirects/Repository.php:716
msgid "Target must be a site path starting with \"/\" or an http(s) URL."
msgstr "Cíl musí být cesta na webu začínající „/\" nebo http(s) URL."

#: includes/Modules/Redirects/Repository.php:749
msgid "This redirect would create a loop (the target leads back to the source)."
msgstr "Toto přesměrování by vytvořilo smyčku (cíl vede zpět na zdroj)."

#: includes/Modules/Redirects/Repository.php:780
msgid "The target itself is marked 410 Gone - pick a live page or use 410 for this source too."
msgstr "Cíl je sám označený jako 410 Gone - vyberte živou stránku, nebo použijte 410 i pro tento zdroj."

#. translators: 1: original target, 2: final target
#: includes/Modules/Redirects/Repository.php:788
#, php-format
msgid "Target %1$s is itself redirected - pointed straight to %2$s to avoid a redirect chain."
msgstr "Cíl %1$s je sám přesměrovaný - pravidlo vede rovnou na %2$s, aby nevznikl řetěz přesměrování."

#: includes/Modules/Redirects/Repository.php:799
msgid "Redirecting to the homepage is treated as a soft 404 by Google. Prefer the closest matching page, or 410 when the content is gone."
msgstr "Přesměrování na úvodní stránku bere Google jako soft 404. Zvolte nejbližší odpovídající stránku, nebo 410, pokud obsah zanikl."

#: includes/Modules/Redirects/Repository.php:802
msgid "Temporary redirect: search engines keep the old URL indexed and do not pass its ranking. Use 301/308 for permanent moves."
msgstr "Dočasné přesměrování: vyhledávače nechají starou URL v indexu a nepředají její hodnocení. Pro trvalý přesun použijte 301/308."

#: includes/Modules/Redirects/Repository.php:805
msgid "Target is not a known post or page - verify it answers 200 (test-url with live=true)."
msgstr "Cíl není známý příspěvek ani stránka - ověřte, že vrací 200 (test URL s živou kontrolou)."

#: includes/Modules/Redirects/Repository.php:808
msgid "The source URL currently shows live content - the redirect will hide it."
msgstr "Na zdrojové URL je teď živý obsah - přesměrování ho skryje."

#. translators: %d: rule id
#: includes/Modules/Redirects/Repository.php:571
#, php-format
msgid "Another rule (#%d) already handles this source."
msgstr "Tento zdroj už obsluhuje jiné pravidlo (#%d)."

#: includes/Modules/Redirects/Repository.php:573
msgid "Source already has a rule - skipped."
msgstr "Zdroj už má pravidlo - přeskočeno."

#: includes/Modules/Redirects/RestController.php:72
msgid "items must be a non-empty array."
msgstr "items musí být neprázdné pole."

#: includes/Modules/Redirects/RestController.php:167
msgid "CSV is empty."
msgstr "CSV je prázdné."

#: includes/Modules/Redirects/Tester.php:195
msgid "Invalid regular expression - the rule never matches."
msgstr "Neplatný regulární výraz - pravidlo se nikdy neuplatní."

#: includes/Modules/Redirects/Tester.php:202
msgid "The target post is no longer published - pick a new target or switch to 410."
msgstr "Cílový příspěvek už není publikovaný - vyberte nový cíl nebo přepněte na 410."

#: includes/Modules/Redirects/Tester.php:209
msgid "Redirect loop."
msgstr "Smyčka přesměrování."

#. translators: %d: hops
#: includes/Modules/Redirects/Tester.php:219
#, php-format
msgid "Redirect chain with %d hops - each hop loses crawl budget; point straight at the final URL."
msgstr "Řetěz přesměrování s %d kroky - každý krok ubírá crawl budget; směřujte rovnou na konečnou URL."

#: includes/Modules/Redirects/Tester.php:226
msgid "Temporary redirect older than 30 days - if the move is permanent, switch to 301 so the ranking is passed."
msgstr "Dočasné přesměrování starší než 30 dní - pokud je přesun trvalý, přepněte na 301, aby se předalo hodnocení."

#: includes/Modules/Redirects/Tester.php:230
msgid "The source URL has live content again - the redirect hides it. Delete the rule if the page should be reachable."
msgstr "Na zdrojové URL je znovu živý obsah - přesměrování ho skrývá. Pokud má být stránka dostupná, pravidlo smažte."

#. translators: 1: status, 2: hops
#: includes/Modules/Redirects/Tester.php:239
#, php-format
msgid "Target answers HTTP %1$d after %2$d extra hop(s) - it must answer 200 directly."
msgstr "Cíl vrací HTTP %1$d po %2$d dalších krocích - musí vracet 200 přímo."

#. translators: %d: number of rules
#: includes/Modules/Redirects/Tester.php:252
#, php-format
msgid "%d rules send visitors to the homepage. Google treats mass homepage redirects as soft 404s - map each URL to its closest page or use 410."
msgstr "Pravidel posílajících návštěvníky na úvodní stránku: %d. Google bere hromadná přesměrování na úvodní stránku jako soft 404 - namapujte každou URL na nejbližší stránku, nebo použijte 410."

#: build/395.12e8b2a0025a5788a3ef.js:6
msgid "301 Moved permanently (recommended)"
msgstr "301 Trvale přesunuto (doporučeno)"

#: build/395.12e8b2a0025a5788a3ef.js:6
msgid "308 Permanent, keeps method"
msgstr "308 Trvale, zachová metodu"

