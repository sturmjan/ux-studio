# UX Studio Security — blokovat přímý HTTP přístup k souborům tohoto modulu.
# Tiny File Manager se načítá výhradně přes WordPress (routa /spravce-souboru/),
# nikdy ne přímým voláním .php souboru. Přímý přístup = neautentizovaný RCE.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
