# Závislosti
node_modules/
vendor/*
# ...ale plugin-update-checker se VERSIONUJE i ships v release zipu (jinak auto-update nefunguje).
!vendor/plugin-update-checker/

# Build (generuje se z src/ přes @wordpress/scripts)
build/

# Tajné
.env
.env.*

# Smetí
*.log
*.bak
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temporary translation inputs of po-missing.py / po-append.py
languages/.build/*.json

# Per-chunk JS translation files made by `wp i18n make-json` (md5 of the chunk path). The SPA loads only the
# handle-named file ux-studio-<locale>-ux-studio-app.json (merged by bin/merge-json-translations.php).
/languages/ux-studio-*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

__pycache__/
